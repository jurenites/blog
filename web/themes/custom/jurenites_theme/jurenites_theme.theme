<?php

/**
 * @file
 * Theme preprocess hooks for jurenites Theme.
 */

use Drupal\Core\Cache\CacheableMetadata;
use Drupal\Core\Language\LanguageInterface;
use Drupal\Core\Render\Element;
use Drupal\Core\Render\Markup;
use Drupal\Core\Url;
use Drupal\Component\Utility\Html;
use Drupal\gin\GinNavigation;
use Drupal\gin\GinSettings;
use Drupal\jurenites_blog\TagSlugResolver;
use Drupal\node\NodeInterface;
use Drupal\taxonomy\TermInterface;
use Drupal\views\ViewExecutable;

/**
 * Implements hook_theme().
 */
function jurenites_theme_theme(
  array $existing_themes,
  string $theme_type,
  string $theme_name,
  string $theme_path,
): array {
  return [
    'badge' => [
      'variables' => [
        'attributes' => [],
        'badge_label' => '',
        'numeric_style' => FALSE,
        'color_variant' => 'neutral',
      ],
      'template' => 'components/badge',
    ],
  ];
}

/**
 * Supplies the shared social profiles and local SVG assets to the footer.
 */
function jurenites_theme_preprocess_menu(array &$menu_variables): void {
  if (($menu_variables['menu_name'] ?? '') !== 'footer') {
    return;
  }

  $theme_path = \Drupal::service('extension.list.theme')->getPath('jurenites_theme');
  $menu_variables['social_links'] = json_decode(
    file_get_contents(DRUPAL_ROOT . '/' . $theme_path . '/social-links.json'),
    TRUE,
    512,
    JSON_THROW_ON_ERROR,
  );
  $menu_variables['icon_asset_base_url'] = base_path() . $theme_path . '/assets/icons';
  $menu_variables['messenger_links'] = [
    [
      'link_label' => 'Telegram',
      'hover_label' => '@jurenites',
      'link_url' => 'https://t.me/jurenites',
      'icon_name' => 'brand-telegram',
    ],
    [
      'link_label' => 'Gmail',
      'hover_label' => 'jurenites@gmail.com',
      'link_url' => 'mailto:jurenites@gmail.com',
      'icon_name' => 'brand-gmail',
    ],
    [
      'link_label' => 'Yandex.Mail',
      'hover_label' => 'jurenites@yandex.ru',
      'link_url' => 'mailto:jurenites@yandex.ru',
      'icon_name' => 'brand-yandex-mail',
    ],
  ];
  $how_i_work_menu_items = [];
  $information_menu_items = [];
  $route_match = \Drupal::routeMatch();
  $parent_breadcrumb = \Drupal::service('breadcrumb')->build($route_match);
  $ancestor_urls = array_map(
    static fn($breadcrumb_link): string => $breadcrumb_link->getUrl()->toString(),
    $parent_breadcrumb->getLinks(),
  );
  $current_page_url = Url::fromRoute('<current>')->toString();
  $navigation_cache = CacheableMetadata::createFromObject($parent_breadcrumb)
    ->addCacheContexts(['route', 'url.path']);
  $menu_variables['footer_navigation_cache'] = [];
  $navigation_cache->applyTo($menu_variables['footer_navigation_cache']);
  foreach ($menu_variables['items'] as $footer_menu_item) {
    $footer_item_url = $footer_menu_item['url']->toString();
    // Query-specific links such as Fonts retain their own exact-link behavior.
    $is_section_link = !$footer_menu_item['url']->getOption('query');
    $is_current_page = $is_section_link && $footer_item_url === $current_page_url;
    $is_parent_page = $is_section_link
      && $footer_item_url !== Url::fromRoute('<front>')->toString()
      && (in_array($footer_item_url, $ancestor_urls, TRUE) || $footer_menu_item['in_active_trail']);
    if ($is_current_page || $is_parent_page) {
      $footer_menu_item['attributes']->addClass('is-active');
      $footer_menu_item['attributes']->setAttribute('aria-current', $is_current_page ? 'page' : 'location');
    }
    $footer_item_title = strtolower(strip_tags((string) ($footer_menu_item['title'] ?? '')));
    if (in_array($footer_item_title, ['cookbook', 'guidelines'], TRUE)) {
      if ($footer_item_title === 'guidelines') {
        $footer_menu_item['title'] = t('Guideline');
      }
      $how_i_work_menu_items[] = $footer_menu_item;
    }
    else {
      $information_menu_items[] = $footer_menu_item;
    }
  }
  $menu_variables['how_i_work_menu_items'] = $how_i_work_menu_items;
  $menu_variables['information_menu_items'] = $information_menu_items;
  $menu_variables['how_i_work_links'] = [
    [
      'link_label' => 'GitHub',
      'hover_label' => 'blog_jurenites',
      'link_url' => 'https://github.com/jurenites/blog',
      'icon_name' => 'brand-github',
      'color_token' => 'github',
    ],
    [
      'link_label' => 'Figma',
      'hover_label' => 'blog jurenites',
      'link_url' => 'https://www.figma.com/design/UMshUcV87SZqsg1aDaDpnZ/blog-jurenites?node-id=928-133&t=n2l2EWw0ldyJzj4u-0',
      'icon_name' => 'brand-figma',
      'color_token' => 'figma',
      'hover_parts' => [
        ['text' => 'bl', 'color_token' => 'figma-overlay-bl'],
        ['text' => 'og', 'color_token' => 'figma-overlay-og'],
        ['text' => "\u{00A0}", 'color_token' => ''],
        ['text' => 'jur', 'color_token' => 'figma-overlay-jur'],
        ['text' => 'eni', 'color_token' => 'figma-overlay-eni'],
        ['text' => 'tes', 'color_token' => 'figma-overlay-tes'],
      ],
    ],
    [
      'link_label' => 'Storybook',
      'hover_label' => 'blog jurenites',
      'link_url' => 'http://storybook.jurenites.com/',
      'icon_name' => 'brand-storybook',
      'color_token' => 'storybook',
    ],
  ];
}

/**
 * Composes the public header from Drupal's existing blocks and languages.
 */
function jurenites_theme_preprocess_page(array &$page_variables): void {
  $site_branding_key = 'jurenites_theme_site_branding';
  $main_navigation_key = 'jurenites_theme_main_menu';

  $page_variables['site_branding'] = $page_variables['page']['header'][$site_branding_key] ?? [];
  $page_variables['main_navigation'] = $page_variables['page']['primary_menu'][$main_navigation_key] ?? [];

  unset(
    $page_variables['page']['header'][$site_branding_key],
    $page_variables['page']['primary_menu'][$main_navigation_key],
  );

  $current_language_id = \Drupal::languageManager()
    ->getCurrentLanguage(LanguageInterface::TYPE_INTERFACE)
    ->getId();
  $current_route_name = \Drupal::service('path.matcher')->isFrontPage()
    ? '<front>'
    : '<current>';
  $current_route_url = Url::fromRoute($current_route_name, [], [
    'query' => \Drupal::request()->query->all(),
  ]);
  $language_labels = [
    'en' => t('Eng'),
    'ru' => t('Rus'),
  ];
  $page_variables['language_options'] = [];

  foreach ($language_labels as $language_id => $language_label) {
    $interface_language = \Drupal::languageManager()->getLanguage($language_id);
    if (!$interface_language) {
      continue;
    }

    $language_url = clone $current_route_url;
    $language_url->setOption('language', $interface_language);
    $page_variables['language_options'][] = [
      'label' => $language_label,
      'url' => $language_url->toString(),
      'selected' => $language_id === $current_language_id,
    ];
  }
}

/**
 * Styles homepage block headings and selects the contextual LEGO wordmark.
 */
function jurenites_theme_preprocess_block(array &$block_variables): void {
  if (in_array($block_variables['elements']['#id'] ?? '', [
    'jurenites_theme_latest_articles',
    'jurenites_theme_news',
  ], TRUE)) {
    $block_variables['title_attributes']['class'][] = 'homepage-block__heading';
  }

  if (($block_variables['base_plugin_id'] ?? '') !== 'system_branding_block'
    || empty($block_variables['site_logo'])) {
    return;
  }

  $slug_resolver = \Drupal::service('jurenites_blog.tag_slug_resolver');
  $lego_term = $slug_resolver->findTermBySlug('lego');
  if (!$lego_term instanceof TermInterface) {
    return;
  }

  // Query arrays are not valid tag selections; leave them to route validation.
  $query_values = \Drupal::request()->query->all();
  $selected_tag = $query_values['tag'] ?? NULL;
  $uses_lego_logo = $selected_tag === 'lego';
  $route_match = \Drupal::routeMatch();
  $route_term = $route_match->getParameter('taxonomy_term');
  if ($route_term instanceof TermInterface) {
    $uses_lego_logo = $uses_lego_logo || $route_term->id() === $lego_term->id();
  }

  $route_node = $route_match->getParameter('node');
  if ($route_match->getRouteName() === 'entity.node.canonical'
    && $route_node instanceof NodeInterface
    && $route_node->hasField('field_tags')) {
    foreach ($route_node->get('field_tags') as $tag_item) {
      if ((string) $tag_item->target_id === (string) $lego_term->id()) {
        $uses_lego_logo = TRUE;
        break;
      }
    }
  }

  $block_variables['uses_lego_logo'] = $uses_lego_logo;
  if ($uses_lego_logo) {
    $theme_path = \Drupal::service('extension.list.theme')->getPath('jurenites_theme');
    $block_variables['site_logo'] = base_path() . $theme_path . '/assets/images/jurenites-lego-logo-square-v2.png';
  }
}

/**
 * Adds the node owner's initials for the shared Avatar fallback.
 */
function jurenites_theme_preprocess_node(array &$node_variables): void {
  $node_entity = $node_variables['node'];
  if ($node_entity->bundle() === 'news') {
    jurenites_theme_add_news_metadata($node_variables);
    return;
  }

  if ($node_entity->bundle() === 'project') {
    $node_variables['body_after_sections'] =
      jurenites_theme_project_has_font_identifier($node_variables, '4pixel')
      || jurenites_theme_project_has_font_identifier($node_variables, 'roundabout');
    jurenites_theme_embed_adjacent_pixel_editor($node_variables);
    return;
  }

  if ($node_entity->bundle() !== 'article') {
    return;
  }

  $created_timestamp = $node_entity->getCreatedTime();
  $date_formatter = \Drupal::service('date.formatter');
  $node_variables['submitted_date_iso'] = $date_formatter->format(
    $created_timestamp,
    'custom',
    DATE_ATOM,
    'UTC',
  );
  $node_variables['submitted_date_text'] = $date_formatter->format($created_timestamp, 'medium');

  $owner_name = trim($node_entity->getOwner()->getDisplayName());
  $author_initials_overrides = [
    'jurenites' => 'AI',
  ];

  if (isset($author_initials_overrides[$owner_name])) {
    $node_variables['author_initials'] = $author_initials_overrides[$owner_name];
  }
  else {
    $node_variables['author_initials'] = jurenites_theme_name_initials($owner_name);
  }

  jurenites_theme_add_youtube_metadata($node_variables);

  $has_youtube_video = $node_entity->hasField('field_youtube_video')
    && !$node_entity->get('field_youtube_video')->isEmpty();
  $consumption_minutes = $node_entity->hasField('field_consumption_time_minutes')
    ? (int) $node_entity->get('field_consumption_time_minutes')->value
    : 0;
  if (!$has_youtube_video && $consumption_minutes < 1) {
    $consumption_minutes = 5;
  }

  if ($consumption_minutes > 0) {
    $consumption_label = $has_youtube_video
      ? t('min to watch')
      : t('min to read');
    $node_variables['reading_time_minutes'] = (string) $consumption_minutes;
    $node_variables['reading_time_label'] = $consumption_label;
  }

}

/**
 * Checks whether a Project contains a Font Preview for a font identifier.
 */
function jurenites_theme_project_has_font_identifier(array $node_variables, string $font_identifier): bool {
  if (empty($node_variables['content']['field_content_sections'])) {
    return FALSE;
  }

  $section_builds = $node_variables['content']['field_content_sections'];
  foreach (Element::children($section_builds) as $section_delta) {
    $section_paragraph = $section_builds[$section_delta]['#paragraph'] ?? NULL;
    if ($section_paragraph !== NULL
      && $section_paragraph->bundle() === 'font_preview'
      && $section_paragraph->hasField('field_font_identifier')
      && $section_paragraph->get('field_font_identifier')->value === $font_identifier) {
      return TRUE;
    }
  }

  return FALSE;
}

/**
 * Composes an adjacent 4pixel editor immediately before Font Preview Data.
 */
function jurenites_theme_embed_adjacent_pixel_editor(array &$node_variables): void {
  if (empty($node_variables['content']['field_content_sections'])) {
    return;
  }

  $section_builds = &$node_variables['content']['field_content_sections'];
  $section_deltas = Element::children($section_builds);

  foreach ($section_deltas as $section_position => $section_delta) {
    $font_preview = $section_builds[$section_delta]['#paragraph'] ?? NULL;
    if ($font_preview === NULL
      || $font_preview->bundle() !== 'font_preview'
      || !$font_preview->hasField('field_font_identifier')
      || $font_preview->get('field_font_identifier')->value !== '4pixel') {
      continue;
    }

    $editor_delta = $section_deltas[$section_position + 1] ?? NULL;
    $pixel_editor = $editor_delta !== NULL
      ? ($section_builds[$editor_delta]['#paragraph'] ?? NULL)
      : NULL;
    if ($pixel_editor === NULL || $pixel_editor->bundle() !== 'pixel_glyph_editor') {
      continue;
    }

    $section_builds[$section_delta]['#pixel_editor_before_data'] = $section_builds[$editor_delta];
    unset($section_builds[$editor_delta]);
    return;
  }
}

/**
 * Exposes manually curated News fields to the shared list-item template.
 */
function jurenites_theme_add_news_metadata(array &$node_variables): void {
  $news_node = $node_variables['node'];
  $source_url = trim((string) $news_node->get('field_news_source_url')->uri);
  $source_name = trim((string) $news_node->get('field_news_source_name')->value);
  $source_published_value = trim((string) $news_node->get('field_news_source_published')->value);

  $node_variables['news_source_url'] = $source_url;
  $node_variables['news_source_name'] = $source_name;
  $theme_path = \Drupal::service('extension.list.theme')->getPath('jurenites_theme');
  $node_variables['icon_asset_base_url'] = '/' . $theme_path . '/assets/icons';
  $node_variables['news_tag_names'] = [];
  foreach ($news_node->get('field_tags')->referencedEntities() as $tag_entity) {
    if (!$tag_entity instanceof TermInterface) {
      continue;
    }

    $tag_entity = \Drupal::service('entity.repository')->getTranslationFromContext($tag_entity);
    $node_variables['news_tag_names'][] = $tag_entity->label();
    CacheableMetadata::createFromObject($tag_entity)
      ->applyTo($node_variables['elements']);
  }

  $image_item = $news_node->get('field_image')->first();
  $image_file = $image_item?->entity;
  if ($image_file !== NULL) {
    $node_variables['news_thumbnail_url'] =
      \Drupal::service('file_url_generator')->generateString($image_file->getFileUri());
    $node_variables['news_thumbnail_alt'] = trim((string) $image_item->alt)
      ?: $news_node->label();
    CacheableMetadata::createFromObject($image_file)
      ->applyTo($node_variables['elements']);
  }

  if ($source_published_value === '') {
    return;
  }

  $source_date = new \DateTimeImmutable(
    $source_published_value,
    new \DateTimeZone('UTC'),
  );
  $date_formatter = \Drupal::service('date.formatter');
  $elapsed_time_markup = jurenites_theme_time_since_markup($source_date);
  $node_variables['news_published_date_iso'] = $source_date->format(DATE_ATOM);
  $node_variables['news_published_date_title'] = $date_formatter->format(
    $source_date->getTimestamp(),
    'long',
  );
  $node_variables['news_published_date_markup'] = Markup::create(sprintf(
    '%s %s',
    $elapsed_time_markup,
    Html::escape((string) t('ago')),
  ));

  $current_date = new \DateTimeImmutable('now', new \DateTimeZone('UTC'));
  $next_update_timestamp = $source_date->diff($current_date)->days >= 1
    ? $current_date->modify('tomorrow')->setTime(0, 0)->getTimestamp()
    : $current_date->modify('+1 minute')->getTimestamp();
  $node_variables['elements']['#cache']['max-age'] = max(
    0,
    $next_update_timestamp - $current_date->getTimestamp(),
  );
}

/**
 * Builds compact initials from a person or channel display name.
 */
function jurenites_theme_name_initials(string $display_name): string {
  $name_parts = preg_split('/\s+/u', trim($display_name), -1, PREG_SPLIT_NO_EMPTY) ?: [];
  $display_initials = '';

  foreach (array_slice($name_parts, 0, 2) as $name_part) {
    $display_initials .= mb_substr($name_part, 0, 1);
  }

  if (count($name_parts) === 1) {
    $display_initials = mb_substr($name_parts[0], 0, 2);
  }

  return mb_strtoupper($display_initials);
}

/**
 * Composes native Article comments from the author's public user profile.
 */
function jurenites_theme_preprocess_comment(array &$comment_variables): void {
  $comment_entity = $comment_variables['comment'];
  $commented_entity = $comment_variables['commented_entity'];
  if ($commented_entity->getEntityTypeId() !== 'node'
    || $commented_entity->bundle() !== 'article') {
    return;
  }

  $comment_author = $comment_entity->getOwner();
  $comment_author_name = $comment_author->hasField('field_full_name')
    ? trim((string) $comment_author->get('field_full_name')->value)
    : '';
  if ($comment_author_name === '') {
    $comment_author_name = trim($comment_author->getDisplayName());
  }

  $comment_author_avatar_image = [];
  if (!$comment_author->isAnonymous()
    && $comment_author->hasField('user_picture')
    && !$comment_author->get('user_picture')->isEmpty()) {
    $comment_author_avatar_image = \Drupal::entityTypeManager()
      ->getViewBuilder('user')
      ->view($comment_author, 'compact');
  }

  $created_timestamp = $comment_entity->getCreatedTime();
  $date_formatter = \Drupal::service('date.formatter');
  $formatted_time_difference = $date_formatter->formatTimeDiffSince(
    $created_timestamp,
    [
      'granularity' => 1,
      'return_as_object' => TRUE,
    ],
  );

  $comment_variables['comment_author_name'] = $comment_author_name;
  $comment_variables['comment_author_initials'] = jurenites_theme_name_initials($comment_author_name);
  $comment_variables['comment_author_avatar_image'] = $comment_author_avatar_image;
  $comment_variables['comment_created_date_iso'] = $date_formatter->format(
    $created_timestamp,
    'custom',
    DATE_ATOM,
    'UTC',
  );
  $comment_variables['comment_created_date_title'] = $date_formatter->format(
    $created_timestamp,
    'long',
  );
  $comment_variables['comment_created_date_markup'] = (string) t('@elapsed_time ago', [
    '@elapsed_time' => $formatted_time_difference->getString(),
  ]);
  $comment_variables['comment_permalink_url'] = '';
  if (!isset($comment_entity->in_preview)) {
    $comment_language_id = $comment_entity->language()->getId();
    $commented_entity_translation = $commented_entity->hasTranslation($comment_language_id)
      ? $commented_entity->getTranslation($comment_language_id)
      : $commented_entity;
    $comment_permalink = $commented_entity_translation->toUrl();
    $comment_permalink->setOption('fragment', 'comment-' . $comment_entity->id());
    $comment_variables['comment_permalink_url'] = $comment_permalink->toString();
    CacheableMetadata::createFromObject($commented_entity_translation)
      ->applyTo($comment_variables['elements']);
  }

  CacheableMetadata::createFromObject($formatted_time_difference)
    ->applyTo($comment_variables['elements']);
}

/**
 * Adds stored creator credit and cached oEmbed presentation metadata.
 */
function jurenites_theme_add_youtube_metadata(array &$node_variables): void {
  $node_entity = $node_variables['node'];
  if (!$node_entity->hasField('field_youtube_video')
    || $node_entity->get('field_youtube_video')->isEmpty()) {
    return;
  }

  $video_url = (string) $node_entity->get('field_youtube_video')->input;
  $stored_creator_name = $node_entity->hasField('field_youtube_creator_name')
    ? trim((string) $node_entity->get('field_youtube_creator_name')->value)
    : '';
  $stored_creator_url = $node_entity->hasField('field_youtube_creator_url')
    ? trim((string) $node_entity->get('field_youtube_creator_url')->uri)
    : '';

  $node_variables['youtube_author_name'] = $stored_creator_name;
  $node_variables['youtube_author_url'] = $stored_creator_url;

  try {
    $resource_url = \Drupal::service('media.oembed.url_resolver')->getResourceUrl($video_url);
    $video_resource = \Drupal::service('media.oembed.resource_fetcher')->fetchResource($resource_url);
    $node_variables['youtube_video_title'] = $video_resource->getTitle();
    if ($node_variables['youtube_author_name'] === '') {
      $node_variables['youtube_author_name'] = $video_resource->getAuthorName();
    }
    if ($node_variables['youtube_author_url'] === '') {
      $node_variables['youtube_author_url'] = $video_resource->getAuthorUrl()?->toString() ?? '';
    }

    CacheableMetadata::createFromObject($video_resource)
      ->applyTo($node_variables['elements']);
  }
  catch (\Drupal\media\OEmbed\ResourceException $resource_exception) {
    \Drupal::logger('jurenites_theme')->warning(
      'Unable to load YouTube metadata for Article @article_id: @message',
      [
        '@article_id' => $node_entity->id(),
        '@message' => $resource_exception->getMessage(),
      ],
    );
  }

  $node_variables['youtube_author_initials'] = jurenites_theme_name_initials(
    (string) $node_variables['youtube_author_name'],
  );

  $youtube_published_date = $node_entity->hasField('field_youtube_published_date')
    ? trim((string) $node_entity->get('field_youtube_published_date')->value)
    : '';
  if ($youtube_published_date !== '') {
    $published_date = new \DateTimeImmutable(
      $youtube_published_date,
      new \DateTimeZone('UTC'),
    );
    $node_variables['youtube_published_date_iso'] = $youtube_published_date;
    $node_variables['youtube_published_date_text'] = jurenites_theme_time_since_markup($published_date);

    $current_date = new \DateTimeImmutable('now', new \DateTimeZone('UTC'));
    $next_update_timestamp = $published_date->diff($current_date)->days >= 1
      ? $current_date->modify('tomorrow')->setTime(0, 0)->getTimestamp()
      : $current_date->modify('+1 minute')->getTimestamp();
    $node_variables['elements']['#cache']['max-age'] = max(
      0,
      $next_update_timestamp - $current_date->getTimestamp(),
    );
  }

  $channel_avatar_url = $node_entity->hasField('field_youtube_channel_avatar')
    ? trim((string) $node_entity->get('field_youtube_channel_avatar')->value)
    : '';
  $channel_avatar_host = mb_strtolower((string) parse_url($channel_avatar_url, PHP_URL_HOST));
  if ($channel_avatar_url
    && in_array($channel_avatar_host, ['yt3.googleusercontent.com', 'yt3.ggpht.com'], TRUE)) {
    $node_variables['youtube_author_avatar'] = [
      '#theme' => 'image',
      '#uri' => $channel_avatar_url,
      '#alt' => '',
      '#attributes' => [
        'loading' => 'lazy',
        'width' => 16,
        'height' => 16,
      ],
    ];
  }

}

/**
 * Formats the elapsed calendar time for a stored source publication date.
 */
function jurenites_theme_time_since_markup(\DateTimeImmutable $source_date): Markup {
  $current_date = new \DateTimeImmutable('now', new \DateTimeZone('UTC'));
  if ($source_date > $current_date) {
    $source_date = $current_date;
  }

  $date_interval = $source_date->diff($current_date);
  $translated_parts = [];

  if ($date_interval->days >= 1) {
    if ($date_interval->y > 0) {
      $translated_parts[] = \Drupal::translation()->formatPlural(
        $date_interval->y,
        '1 year',
        '@count years',
      );
    }
    if ($date_interval->m > 0) {
      $translated_parts[] = \Drupal::translation()->formatPlural(
        $date_interval->m,
        '1 month',
        '@count months',
      );
    }
    if ($date_interval->d > 0 || $translated_parts === []) {
      $translated_parts[] = \Drupal::translation()->formatPlural(
        $date_interval->d,
        '1 day',
        '@count days',
      );
    }
  }
  else {
    if ($date_interval->h > 0) {
      $translated_parts[] = \Drupal::translation()->formatPlural(
        $date_interval->h,
        '1 hour',
        '@count hours',
      );
    }
    if ($date_interval->i > 0 || $translated_parts === []) {
      $translated_parts[] = \Drupal::translation()->formatPlural(
        $date_interval->i,
        '1 minute',
        '@count minutes',
      );
    }
  }

  $elapsed_time_text = implode(' ', $translated_parts);

  return Markup::create(Html::escape($elapsed_time_text));
}

/**
 * Calculates automatic elapsed-year values for Numeric Value Paragraph tiles.
 */
function jurenites_theme_preprocess_paragraph(array &$paragraph_variables): void {
  $paragraph_entity = $paragraph_variables['paragraph'];
  if ($paragraph_entity->bundle() === 'font_preview') {
    $font_identifier = trim((string) $paragraph_entity->get('field_font_identifier')->value);
    $font_registry = [
      'roundabout' => [
        'title' => 'Roundabout',
        'filename' => 'roundabout-regular.ttf',
        'sample_text' => 'The quick brown fox jumps over the lazy dog.',
      ],
      '4pixel' => [
        'title' => '4pixel',
        'filename' => '4pixel.ttf',
        'sample_text' => 'Five big quacking zephyrs jolt my wax bed.',
      ],
    ];

    if (!isset($font_registry[$font_identifier])) {
      return;
    }

    $font_configuration = $font_registry[$font_identifier];
    $theme_path = \Drupal::service('extension.list.theme')->getPath('jurenites_theme');
    $theme_asset_url = '/' . $theme_path . '/assets';
    $paragraph_variables['font_identifier'] = $font_identifier;
    $paragraph_variables['font_title'] = $font_configuration['title'];
    $paragraph_variables['font_asset_url'] = $theme_asset_url . '/fonts/' . $font_configuration['filename'];
    $paragraph_variables['font_download_filename'] = $font_configuration['filename'];
    $paragraph_variables['font_sample_text'] = $font_configuration['sample_text'];
    $paragraph_variables['font_preview_id'] = Html::getId(
      'font-preview-' . $paragraph_entity->uuid(),
    );
    $paragraph_variables['icon_asset_base_url'] = $theme_asset_url . '/icons';
    $paragraph_variables['before_data_content'] =
      $paragraph_variables['elements']['#pixel_editor_before_data'] ?? [];
    return;
  }

  if ($paragraph_entity->bundle() !== 'numeric_value') {
    return;
  }

  if ($paragraph_entity->hasField('field_numeric_icon_image')) {
    $numeric_icon_file = $paragraph_entity->get('field_numeric_icon_image')->entity;
    if ($numeric_icon_file !== NULL) {
      $paragraph_variables['numeric_icon_url'] = \Drupal::service('file_url_generator')
        ->generateString($numeric_icon_file->getFileUri());
      CacheableMetadata::createFromObject($numeric_icon_file)
        ->applyTo($paragraph_variables['elements']);
    }
  }

  if ($paragraph_entity->hasField('field_numeric_link')
    && !$paragraph_entity->get('field_numeric_link')->isEmpty()) {
    $numeric_link_item = $paragraph_entity
      ->get('field_numeric_link')
      ->first();
    $paragraph_variables['numeric_link_url'] = $numeric_link_item->getUrl()->toString();
    $paragraph_variables['numeric_link_label'] = trim((string) $numeric_link_item->title) ?: t('See more');
  }

  if ($paragraph_entity->hasField('field_numeric_caption_link')
    && !$paragraph_entity->get('field_numeric_caption_link')->isEmpty()) {
    $caption_link_item = $paragraph_entity->get('field_numeric_caption_link')->first();
    $paragraph_variables['numeric_caption_link_url'] = $caption_link_item->getUrl()->toString();
    $paragraph_variables['numeric_caption_link_label'] = trim((string) $caption_link_item->title)
      ?: $paragraph_variables['numeric_caption_link_url'];
  }

  $paragraph_variables['numeric_value_text'] = (string) $paragraph_entity->get('field_numeric_number')->value;
}

/**
 * Keeps compact author pictures visual rather than linking to user profiles.
 */
function jurenites_theme_preprocess_user(array &$user_variables): void {
  if (($user_variables['elements']['#view_mode'] ?? '') !== 'compact'
    || empty($user_variables['content']['user_picture'])) {
    return;
  }

  foreach ($user_variables['content']['user_picture'] as &$picture_element) {
    if (is_array($picture_element)) {
      unset($picture_element['#url']);
      $picture_element['#attributes']['class'][] = 'avatar__uploaded-image';
    }
  }
}

/**
 * Resolves the Git metadata directory for a repository checkout.
 */
function jurenites_theme_git_directory(string $project_directory): string {
  $git_metadata_path = $project_directory . '/.git';

  if (is_dir($git_metadata_path)) {
    return $git_metadata_path;
  }

  if (!is_readable($git_metadata_path)) {
    return '';
  }

  $git_metadata_content = trim((string) file_get_contents($git_metadata_path));
  if (!str_starts_with($git_metadata_content, 'gitdir:')) {
    return '';
  }

  $git_directory_path = trim(substr($git_metadata_content, strlen('gitdir:')));
  if (!str_starts_with($git_directory_path, '/')) {
    $git_directory_path = $project_directory . '/' . $git_directory_path;
  }

  $resolved_git_directory = realpath($git_directory_path);
  return $resolved_git_directory !== FALSE && is_dir($resolved_git_directory)
    ? $resolved_git_directory
    : '';
}

/**
 * Reads the checked-out commit without executing Git or writing host metadata.
 */
function jurenites_theme_git_commit_hash(string $project_directory): string {
  $git_directory_path = jurenites_theme_git_directory($project_directory);
  $git_head_path = $git_directory_path !== ''
    ? $git_directory_path . '/HEAD'
    : '';

  if ($git_head_path === '' || !is_readable($git_head_path)) {
    return '';
  }

  $git_head_value = trim((string) file_get_contents($git_head_path));
  if (preg_match('/^[0-9a-f]{40,64}$/i', $git_head_value)) {
    return strtolower($git_head_value);
  }

  if (!str_starts_with($git_head_value, 'ref:')) {
    return '';
  }

  $git_reference_name = trim(substr($git_head_value, strlen('ref:')));
  $git_reference_path = $git_directory_path . '/' . $git_reference_name;
  if (is_readable($git_reference_path)) {
    $git_reference_hash = trim((string) file_get_contents($git_reference_path));
    if (preg_match('/^[0-9a-f]{40,64}$/i', $git_reference_hash)) {
      return strtolower($git_reference_hash);
    }
  }

  $packed_references_path = $git_directory_path . '/packed-refs';
  if (!is_readable($packed_references_path)) {
    return '';
  }

  $packed_reference_lines = file($packed_references_path, FILE_IGNORE_NEW_LINES);
  foreach ($packed_reference_lines ?: [] as $packed_reference_line) {
    if ($packed_reference_line === ''
      || str_starts_with($packed_reference_line, '#')
      || str_starts_with($packed_reference_line, '^')) {
      continue;
    }

    [$packed_reference_hash, $packed_reference_name] = array_pad(
      preg_split('/\s+/', trim($packed_reference_line), 2) ?: [],
      2,
      '',
    );
    if ($packed_reference_name === $git_reference_name
      && preg_match('/^[0-9a-f]{40,64}$/i', $packed_reference_hash)) {
      return strtolower($packed_reference_hash);
    }
  }

  return '';
}

/**
 * Returns the first route segment without the configured language prefix.
 */
function jurenites_theme_language_neutral_root_path(
  string $request_path,
  string $language_prefix,
): string {
  $normalized_path = trim($request_path, '/');
  $normalized_prefix = trim($language_prefix, '/');
  if ($normalized_prefix !== ''
    && ($normalized_path === $normalized_prefix
      || str_starts_with($normalized_path, $normalized_prefix . '/'))) {
    $normalized_path = ltrim(substr($normalized_path, strlen($normalized_prefix)), '/');
  }

  return explode('/', $normalized_path, 2)[0] ?? '';
}

/**
 * Adds tracked release identity and read-only Git identity to global HTML.
 */
function jurenites_theme_preprocess_html(array &$html_variables): void {
  $html_variables['attributes']['class'][] = 'jurenites-theme';
  $html_variables['admin_navigation'] = jurenites_theme_build_admin_navigation();
  if ($html_variables['admin_navigation']) {
    unset($html_variables['page_top']['navigation']);
  }

  $url_language_id = \Drupal::languageManager()
    ->getCurrentLanguage(LanguageInterface::TYPE_URL)
    ->getId();
  $language_prefixes = \Drupal::config('language.negotiation')->get('url.prefixes') ?? [];
  $language_prefix = (string) ($language_prefixes[$url_language_id] ?? '');
  $root_page_path = jurenites_theme_language_neutral_root_path(
    \Drupal::request()->getPathInfo(),
    $language_prefix,
  );
  if ($root_page_path !== '') {
    $html_variables['attributes']['class'][] = 'path-' . Html::getClass($root_page_path);
  }

  $theme_path = \Drupal::service('extension.list.theme')->getPath('jurenites_theme');
  $sprite_manifest_path = DRUPAL_ROOT . '/' . $theme_path . '/assets/icon-sprites/manifest.json';
  $sprite_manifest = is_readable($sprite_manifest_path)
    ? json_decode(file_get_contents($sprite_manifest_path), TRUE)
    : [];
  $sprite_asset_name = $sprite_manifest['asset_name'] ?? '';
  if (preg_match('/^icons\.[a-f0-9]{16}\.svg$/', $sprite_asset_name)) {
    $html_variables['attributes']['data-icon-sprite-url'] = base_path() . $theme_path
      . '/assets/icon-sprites/' . $sprite_asset_name;
  }

  $release_info_path = DRUPAL_ROOT . '/' . $theme_path . '/release-info.json';

  $release_information = is_readable($release_info_path)
    ? json_decode(file_get_contents($release_info_path), TRUE)
    : [];
  $release_information = is_array($release_information) ? $release_information : [];

  $project_directory = dirname(DRUPAL_ROOT);
  $full_commit_hash = jurenites_theme_git_commit_hash($project_directory);
  $short_commit_hash = $full_commit_hash !== ''
    ? substr($full_commit_hash, 0, 7)
    : (string) t('unknown');
  $repository_url = rtrim((string) ($release_information['repository_url'] ?? ''), '/');
  $commit_url = $repository_url !== '' && $full_commit_hash !== ''
    ? $repository_url . '/commit/' . $full_commit_hash
    : '';
  $project_version = $release_information['project_version'] ?? t('unknown');
  $collaboration_credit = $release_information['collaboration_credit'] ?? [];
  $collaboration_credit = is_array($collaboration_credit)
    ? array_values(array_filter($collaboration_credit, 'is_string'))
    : [];
  $released_gmt = $release_information['released_gmt'] ?? t('unknown GMT+0');
  $html_variables['watermark_version_label'] = t('version');
  $html_variables['watermark_version_number'] = $project_version;
  $html_variables['watermark_updated_gmt'] = $released_gmt;
  $html_variables['watermark_git_hash'] = $short_commit_hash;
  $html_variables['watermark_git_url'] = $commit_url;
  $html_variables['watermark_credit_text'] = t('made by');
  $html_variables['watermark_credit_collaborators'] = $collaboration_credit !== []
    ? $collaboration_credit
    : [(string) t('unknown')];
}

/**
 * Builds detail breadcrumbs and suppresses first-level Views listing trails.
 */
function jurenites_theme_preprocess_breadcrumb(array &$breadcrumb_variables): void {
  $route_match = \Drupal::routeMatch();
  $breadcrumb_cache = (new CacheableMetadata())->addCacheContexts(['route', 'url.path']);
  $node_entity = $route_match->getParameter('node');
  if ($node_entity instanceof NodeInterface) {
    $breadcrumb_cache->addCacheableDependency($node_entity);
  }
  $breadcrumb_variables['breadcrumb_navigation_cache'] = [];
  $breadcrumb_cache->applyTo($breadcrumb_variables['breadcrumb_navigation_cache']);
  $route_name = (string) $route_match->getRouteName();
  $route_object = $route_match->getRouteObject();
  $requested_path = trim(\Drupal::request()->getPathInfo(), '/');
  if (str_starts_with($route_name, 'view.')
    && $requested_path !== ''
    && !str_contains($requested_path, '/')) {
    $breadcrumb_variables['breadcrumb'] = [];
    return;
  }

  $node_entity = $route_match->getParameter('node');
  if ($node_entity instanceof \Drupal\node\NodeInterface
    && $node_entity->bundle() === 'article') {
    $listing_path = $node_entity->hasField('field_youtube_video')
      && !$node_entity->get('field_youtube_video')->isEmpty()
        ? '/videos'
        : '/blog';
    $breadcrumb_variables['article_back_url'] = Url::fromUserInput($listing_path);
    $theme_path = \Drupal::service('extension.list.theme')->getPath('jurenites_theme');
    $breadcrumb_variables['icon_asset_base_url'] = '/' . $theme_path . '/assets/icons';
  }

  if (empty($breadcrumb_variables['breadcrumb'])) {
    return;
  }

  $last_item = end($breadcrumb_variables['breadcrumb']);
  if (empty($last_item['url'])) {
    return;
  }

  if (!$route_object) {
    return;
  }

  $current_title = \Drupal::service('title_resolver')->getTitle(
    \Drupal::request(),
    $route_object,
  );
  if ($current_title === NULL) {
    return;
  }

  $breadcrumb_variables['breadcrumb'][] = [
    'text' => $current_title,
  ];

  $home_breadcrumb_url = Url::fromRoute('<front>')->toString();
  $breadcrumb_variables['breadcrumb'] = array_values(array_filter(
    $breadcrumb_variables['breadcrumb'],
    static fn(array $breadcrumb_item): bool => ($breadcrumb_item['url'] ?? '') !== $home_breadcrumb_url,
  ));
}

/**
 * Renders structured Basic page titles and identifies Article detail titles.
 */
function jurenites_theme_preprocess_page_title(array &$page_title_variables): void {
  $node_entity = \Drupal::routeMatch()->getParameter('node');
  if ($node_entity instanceof \Drupal\node\NodeInterface
    && $node_entity->bundle() === 'page'
    && $node_entity->hasField('field_two_tone_heading')
    && !$node_entity->get('field_two_tone_heading')->isEmpty()) {
    $heading_field_item = $node_entity->get('field_two_tone_heading')->first();
    $page_title_variables['two_tone_heading'] = [
      '#theme' => 'two_tone_heading',
      '#heading_level' => 'h1',
      '#leading_text' => $node_entity->label(),
      '#soft_text' => $heading_field_item->soft_text,
      '#trailing_text' => $heading_field_item->trailing_text,
      '#soft_text_placement' => $heading_field_item->soft_text_placement,
      '#trailing_text_placement' => $heading_field_item->trailing_text_placement,
    ];
    CacheableMetadata::createFromObject($node_entity)
      ->applyTo($page_title_variables['two_tone_heading']);
  }

  if (!$node_entity instanceof \Drupal\node\NodeInterface
    || $node_entity->bundle() !== 'article') {
    return;
  }

  $page_title_variables['title_attributes']['class'][] = 'article-detail__title';
  $page_title_variables['title_attributes']['data-jurenites-article-title-transition'] = sprintf(
    'article-title-%s',
    $node_entity->id(),
  );
}

/**
 * Adds the full view mode to Article body field template suggestions.
 */
function jurenites_theme_theme_suggestions_field_alter(array &$suggestions, array $variables): void {
  $field_element = $variables['element'];
  if (($field_element['#entity_type'] ?? '') !== 'node'
    || ($field_element['#field_name'] ?? '') !== 'body'
    || ($field_element['#bundle'] ?? '') !== 'article'
    || ($field_element['#view_mode'] ?? '') !== 'full') {
    return;
  }

  $suggestions[] = 'field__node__body__article__full';
}

/**
 * Turns content tags into Chip links to their filtered bundle listing.
 */
function jurenites_theme_preprocess_field(array &$field_variables): void {
  $field_element = $field_variables['element'];
  $field_name = $field_element['#field_name'] ?? '';
  $entity_bundle = $field_element['#bundle'] ?? '';

  if ($field_name === 'field_image' && $entity_bundle === 'project') {
    foreach ($field_variables['items'] as &$image_item_variables) {
      $image_item_variables['content']['#attributes']['class'][] = 'project-detail__image';
    }
    return;
  }

  $is_content_tags = $field_name === 'field_tags'
    && in_array($entity_bundle, ['article', 'project'], TRUE);
  $is_interest_tags = $field_name === 'field_interest_tags'
    && $entity_bundle === 'interests';
  if (!$is_content_tags && !$is_interest_tags) {
    return;
  }

  $field_items = $field_element['#items'];
  $content_entity = $field_items->getEntity();
  if ($is_interest_tags) {
    $listing_path = '/videos';
  }
  elseif ($entity_bundle === 'project') {
    $listing_path = '/portfolio';
  }
  else {
    $listing_path = $content_entity->hasField('field_youtube_video')
      && !$content_entity->get('field_youtube_video')->isEmpty()
        ? '/videos'
        : '/blog';
  }
  $tag_slug_resolver = \Drupal::service('jurenites_blog.tag_slug_resolver');
  assert($tag_slug_resolver instanceof TagSlugResolver);
  foreach ($field_variables['items'] as $item_delta => &$item_variables) {
    $referenced_term = $field_items->get($item_delta)->entity;
    if (!$referenced_term instanceof TermInterface) {
      continue;
    }

    $item_variables['content']['#url'] = Url::fromUserInput($listing_path, [
      'query' => ['tag' => $tag_slug_resolver->slugify($referenced_term->getUntranslated()->label())],
    ]);
    $item_variables['content']['#attributes']['class'][] = 'chip';
  }
}

/**
 * Exposes tag-filter options and the selected tag to listing View templates.
 */
function jurenites_theme_preprocess_views_view(array &$view_variables): void {
  $view_executable = $view_variables['view'];
  $listing_path_by_display = [
    'frontpage:page_2' => '/blog',
    'frontpage:page_3' => '/videos',
    'portfolio:page_1' => '/portfolio',
  ];
  $listing_display_key = sprintf(
    '%s:%s',
    $view_executable->id(),
    $view_executable->current_display,
  );
  if (!isset($listing_path_by_display[$listing_display_key])) {
    return;
  }

  $tag_slug_resolver = \Drupal::service('jurenites_blog.tag_slug_resolver');
  assert($tag_slug_resolver instanceof TagSlugResolver);
  $selected_tag_slug = \Drupal::request()->query->get('tag');
  $selected_term = is_scalar($selected_tag_slug)
    ? $tag_slug_resolver->findTermBySlug((string) $selected_tag_slug)
    : NULL;

  if ($listing_display_key === 'portfolio:page_1') {
    jurenites_theme_add_portfolio_tag_options(
      $view_variables,
      $view_executable,
      $tag_slug_resolver,
      $selected_term instanceof TermInterface ? $selected_term : NULL,
    );
  }

  if (!$selected_term instanceof TermInterface) {
    return;
  }

  $view_variables['selected_tag_label'] = \Drupal::service('entity.repository')->getTranslationFromContext($selected_term)->label();
  $listing_path = $listing_path_by_display[$listing_display_key];
  $view_variables['clear_tag_url'] = Url::fromUserInput($listing_path);
  if ($listing_display_key !== 'portfolio:page_1') {
    $theme_path = \Drupal::service('extension.list.theme')->getPath('jurenites_theme');
    $view_variables['icon_asset_base_url'] = '/' . $theme_path . '/assets/icons';
  }

  CacheableMetadata::createFromObject($selected_term)
    ->addCacheContexts([
      'languages:language_interface',
      'theme',
      'url.query_args:tag',
    ])
    ->applyTo($view_executable->element);
}

/**
 * Builds the persistent tag choices from accessible published Projects.
 */
function jurenites_theme_add_portfolio_tag_options(
  array &$view_variables,
  ViewExecutable $view_executable,
  TagSlugResolver $tag_slug_resolver,
  ?TermInterface $selected_term,
): void {
  $entity_type_manager = \Drupal::entityTypeManager();
  $node_entity_type = $entity_type_manager->getDefinition('node');
  $tag_list_cacheability = (new CacheableMetadata())
    ->addCacheTags($node_entity_type->getListCacheTags())
    ->addCacheTags($node_entity_type->getBundleListCacheTags('project'))
    ->addCacheTags(['taxonomy_term_list:tags'])
    ->addCacheContexts([
      'languages:language_interface',
      'url.query_args:tag',
      'user.node_grants:view',
      'user.permissions',
    ]);

  $project_node_ids = $entity_type_manager->getStorage('node')->getQuery()
    ->accessCheck(TRUE)
    ->condition('type', 'project')
    ->condition('status', NodeInterface::PUBLISHED)
    ->exists('field_tags.target_id')
    ->execute();
  $portfolio_tag_options = [];

  foreach ($entity_type_manager->getStorage('node')->loadMultiple($project_node_ids) as $project_node) {
    if (!$project_node instanceof NodeInterface || !$project_node->hasField('field_tags')) {
      continue;
    }

    $tag_list_cacheability->addCacheableDependency($project_node);
    foreach ($project_node->get('field_tags')->referencedEntities() as $tag_term) {
      if (!$tag_term instanceof TermInterface) {
        continue;
      }

      $term_access = $tag_term->access('view', NULL, TRUE);
      $tag_list_cacheability->addCacheableDependency($term_access);
      if (!$term_access->isAllowed()) {
        continue;
      }

      $tag_list_cacheability->addCacheableDependency($tag_term);
      $tag_slug = $tag_slug_resolver->slugify($tag_term->getUntranslated()->label());
      $is_selected = $selected_term instanceof TermInterface
        && (int) $selected_term->id() === (int) $tag_term->id();
      $portfolio_tag_options[(int) $tag_term->id()] = [
        'label' => \Drupal::service('entity.repository')->getTranslationFromContext($tag_term)->label(),
        'url' => $is_selected
          ? Url::fromUserInput('/portfolio')
          : Url::fromUserInput('/portfolio', ['query' => ['tag' => $tag_slug]]),
        'is_selected' => $is_selected,
      ];
    }
  }

  uasort(
    $portfolio_tag_options,
    static fn(array $first_option, array $second_option): int => strnatcasecmp(
      (string) $first_option['label'],
      (string) $second_option['label'],
    ),
  );
  $view_variables['portfolio_tag_options'] = array_values($portfolio_tag_options);
  $tag_list_cacheability->applyTo($view_executable->element);
}

/**
 * Builds Gin's vertical admin navigation for authorized frontend users.
 */
function jurenites_theme_build_admin_navigation(): array {
  $current_user = \Drupal::currentUser();
  $has_navigation_access = $current_user->hasPermission('access toolbar')
    || $current_user->hasPermission('access navigation');

  if (!$has_navigation_access
    || !\Drupal::moduleHandler()->moduleExists('gin_toolbar')
    || \Drupal::config('system.theme')->get('admin') !== 'gin') {
    return [];
  }

  $gin_settings = \Drupal::classResolver(GinSettings::class);
  if ($gin_settings->get('classic_toolbar') !== 'new') {
    return [];
  }

  $admin_navigation = \Drupal::classResolver(GinNavigation::class)->getNavigationStructure();
  $uses_default_logo = $gin_settings->getDefault('logo.use_default');

  return [
    '#type' => 'inline_template',
    '#template' => "{% include '@gin/navigation/navigation--gin.html.twig' %}",
    '#context' => [
      'icon_path' => $uses_default_logo ? '' : $gin_settings->getDefault('logo.path'),
      'menu_top' => $admin_navigation['#menu_top'],
      'menu_middle' => $admin_navigation['#menu_middle'],
      'menu_bottom' => $admin_navigation['#menu_bottom'],
    ],
    '#attached' => $admin_navigation['#attached'],
    '#access' => $admin_navigation['#access'],
  ];
}

/**
 * Adds the total page count required by the compact pager.
 */
function jurenites_theme_preprocess_pager(array &$pager_variables): void {
  $pager_element = $pager_variables['pager']['#element'] ?? 0;
  $pager_instance = \Drupal::service('pager.manager')->getPager($pager_element);
  $pager_variables['page_count'] = $pager_instance?->getTotalPages() ?? 1;
}
