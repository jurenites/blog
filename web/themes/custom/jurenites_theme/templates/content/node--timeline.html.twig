<article{{ attributes.addClass('timeline') }}>
  {{ title_prefix }}
  {{ title_suffix }}

  <header class="timeline__header">
    <p class="timeline__eyebrow">{{ 'Commercial work'|t }}</p>
    <div class="timeline__introduction">{{ content.body }}</div>
    <p class="timeline__count">{{ timeline_item_count }} {{ 'records'|t }}</p>
  </header>

  <div class="timeline__years">
    {% if timeline_initial_organization %}
      <div class="timeline__organization-sticky" data-jurenites-timeline-organization-sticky>
        {% if timeline_initial_organization.url %}
          <a class="timeline__organization-link" target="_blank" href="{{ timeline_initial_organization.url }}">
            {{ timeline_initial_organization.name }}
          </a>
        {% else %}
          <span class="timeline__organization-heading">{{ timeline_initial_organization.name }}</span>
        {% endif %}
      </div>
    {% endif %}
    {% for year_group in timeline_year_groups %}
      <section class="timeline__year-group timeline__year-group--month-count-{{ year_group.visible_month_count }}" aria-labelledby="timeline-year-{{ year_group.year_label }}">
        <h2 id="timeline-year-{{ year_group.year_label }}" class="timeline__year-heading">
          {{ year_group.year_label }}
        </h2>
        <div class="timeline__year-canvas">
          <ol class="timeline__months" aria-hidden="true">
            {% for timeline_month in year_group.timeline_months %}
              <li class="timeline__month">
                <time datetime="{{ timeline_month.datetime }}">{{ timeline_month.label }}</time>
              </li>
            {% endfor %}
          </ol>
          <ol class="timeline__items" aria-label="{{ 'Project durations'|t }}">
            {% for timeline_item in year_group.timeline_fragments %}
              <li data-timeline-item-name="{{ timeline_item.item_name }}" class="timeline__item timeline__item--project timeline__item--lane-{{ timeline_item.lane_number }} timeline__item--row-start-{{ timeline_item.row_start }} timeline__item--ending-month-{{ timeline_item.ending_month }} timeline__item--month-span-{{ timeline_item.month_span }}{% if timeline_item.is_overflow_overlap %} timeline__item--overlap{% endif %}">
                {% if timeline_item.show_details and timeline_item.organization_heading %}
                  <span
                    class="timeline__organization-transition"
                    data-organization-name="{{ timeline_item.organization_heading.name }}"
                    data-organization-url="{{ timeline_item.organization_heading.url }}"
                    aria-hidden="true"
                  ></span>
                {% endif %}
                <button type="button" class="timeline__marker timeline__marker--duration{% if timeline_item.continues_before %} timeline__marker--continues-before{% endif %}{% if timeline_item.continues_after %} timeline__marker--continues-after{% endif %}" data-project-key="{{ timeline_item.project_key }}" data-period-key="{{ timeline_item.period_key }}" aria-label="{{ timeline_item.item_name }}: {{ timeline_item.period.start_label }} – {{ timeline_item.period.end_label }}"></button>
              </li>
            {% endfor %}
          </ol>
          {% if year_group.timeline_details %}
            <ol class="timeline__year-details">
              {% for timeline_item in year_group.timeline_details %}
                <li class="timeline__year-detail timeline__year-detail--project" data-project-key="{{ timeline_item.project_key }}" data-period-key="{{ timeline_item.period_key }}" data-start-month="{{ timeline_item.start_month }}" tabindex="0">
                  <article class="timeline__item-content">
                    <header class="timeline__item-header">
                      <h3 class="timeline__item-title">
                        {% if timeline_item.primary_project_url %}
                          <a class="timeline__item-details-link" href="{{ timeline_item.primary_project_url }}">
                            {{ timeline_item.item_name }}
                          </a>
                        {% else %}
                          {{ timeline_item.item_name }}
                        {% endif %}
                      </h3>
                      {% if timeline_item.emphasis_kind == 'featured' %}
                        <span class="timeline__emphasis timeline__emphasis--featured">
                          {% include '@jurenites_theme/components/icon.html.twig' with {
                            icon_name: 'star-outline',
                            icon_class: 'timeline__star-icon',
                            icon_asset_base_url: icon_asset_base_url,
                          } only %}
                          {{ 'Featured'|t }}
                        </span>
                      {% elseif timeline_item.emphasis_kind == 'heart' %}
                        <span class="timeline__emphasis timeline__emphasis--heart">
                          {% include '@jurenites_theme/components/icon.html.twig' with {
                            icon_name: 'heart-outline',
                            icon_class: 'timeline__heart-icon',
                            icon_asset_base_url: icon_asset_base_url,
                          } only %}
                          {{ 'Special place in my heart'|t }}
                        </span>
                      {% endif %}
                    </header>
                    <div class="timeline__metadata">
                      <span class="timeline__period">
                        {% include '@jurenites_theme/components/date-time-value.html.twig' with {
                          date_time_datetime: timeline_item.period.start_iso,
                          date_time_display_markup: timeline_item.period.start_label,
                          date_time_date_display_variant: 'date-month',
                        } only %}
                        {% if timeline_item.period.is_range %}
                          <span aria-hidden="true">–</span>
                          {% include '@jurenites_theme/components/date-time-value.html.twig' with {
                            date_time_datetime: timeline_item.period.end_iso,
                            date_time_display_markup: timeline_item.period.end_label,
                            date_time_date_display_variant: 'date-month',
                          } only %}
                        {% endif %}
                      </span>
                    </div>
                    {% if timeline_item.summary_markup %}
                      <div class="timeline__summary">{{ timeline_item.summary_markup }}</div>
                    {% endif %}
                    {% if timeline_item.proof_links %}
                      <ul class="timeline__proof-links" aria-label="{{ 'Project links'|t }}">
                        {% for proof_link in timeline_item.proof_links %}
                          <li><a href="{{ proof_link.url }}">{{ proof_link.label }}</a></li>
                        {% endfor %}
                      </ul>
                    {% endif %}
                  </article>
                </li>
              {% endfor %}
            </ol>
          {% endif %}
        </div>
      </section>
    {% endfor %}
  </div>
</article>
