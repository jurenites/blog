{#
/**
 * @file
 * Full Article node with media connected to its listing teaser.
 */
#}
{% set article_id = node.id %}
{% set article_classes = [
  'article-detail',
  'node--type-' ~ node.bundle|clean_class,
  'node--view-mode-' ~ view_mode|clean_class,
  not node.isPublished() ? 'node--unpublished',
  content.game_of_life ? 'article-detail--game-of-life',
] %}

<article{{ attributes.addClass(article_classes).setAttribute('data-article-id', article_id) }}>
  {{ title_prefix }}
  {{ title_suffix }}

  {{ content.game_of_life }}

  {% if display_submitted and node.field_youtube_video is empty %}
    {% include '@jurenites_theme/components/author-byline.html.twig' with {
      author_avatar_image: author_picture,
      author_avatar_initials: author_initials,
      author_name_markup: author_name,
      published_date_iso: submitted_date_iso,
      published_date_markup: submitted_date_text,
      reading_time_minutes: reading_time_minutes,
      reading_time_label: reading_time_label,
      topic_content: content.field_tags,
    } only %}
  {% endif %}

  {% if node.field_youtube_video is empty and node.field_image is not empty %}
    <div
      class="article-detail__media"
      data-jurenites-article-image-transition="article-image-{{ article_id }}"
    >
      {{ content.field_image }}
    </div>
  {% endif %}

  {% if node.field_youtube_video is not empty %}
    <div class="article-detail__youtube-video">
      <figure class="media-loader youtube-video-loader" data-jurenites-youtube-video-loader aria-busy="true">
        <div
          class="media-loader__noise youtube-video-loader__noise"
          data-jurenites-media-loader-noise
          aria-hidden="true"
        ></div>
        <div class="youtube-video-loader__embed">
          {{ content.field_youtube_video }}
        </div>
        <figcaption class="media-loader__status">
          <progress
            class="media-loader__progress"
            max="100"
            value="0"
            aria-label="{{ 'Loading external video'|t }}"
          ></progress>
        </figcaption>
      </figure>
      {% if youtube_video_title or youtube_author_name %}
        <div class="youtube-video-details">
          {% if youtube_video_title %}
            <p class="youtube-video-details__title">{{ youtube_video_title }}</p>
          {% endif %}
          {% if youtube_author_name %}
            {% include '@jurenites_theme/components/author-byline.html.twig' with {
              byline_label: 'Video creator'|t,
              author_avatar_image: youtube_author_avatar,
              author_avatar_initials: youtube_author_initials,
              avatar_size: 'small',
              author_name_text: youtube_author_name,
              author_url: youtube_author_url,
              published_date_iso: youtube_published_date_iso,
              published_date_markup: youtube_published_date_text,
              date_value_kind: 'elapsed-time',
              date_display_variant: 'date-day',
              reading_time_minutes: reading_time_minutes,
              reading_time_label: reading_time_label,
            } only %}
          {% endif %}
        </div>
      {% endif %}
    </div>
  {% endif %}

  <div{{ content_attributes.addClass('article-detail__content') }}>
    {{ content|without(
      'game_of_life',
      'field_image',
      'field_consumption_time_minutes',
      'field_tags',
      'field_youtube_channel_avatar',
      'field_youtube_creator_name',
      'field_youtube_creator_url',
      'field_youtube_published_date',
      'field_youtube_video',
    ) }}
  </div>
</article>
