<article{{ attributes.addClass('project-detail') }}>
  {% if content.field_image %}
    <div class="project-detail__media">{{ content.field_image }}</div>
  {% endif %}
  <div class="project-detail__introduction">{{ content.body }}</div>
  <div class="project-detail__sections">{{ content.field_content_sections }}</div>
  {% if content.field_tags %}
    <div class="project-detail__tags">{{ content.field_tags }}</div>
  {% endif %}
</article>

