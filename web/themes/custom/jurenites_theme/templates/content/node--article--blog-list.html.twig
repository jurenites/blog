{#
/**
 * @file
 * Article presentation for the dedicated Blog list view mode.
 */
#}
{% set article_id = node.id %}
{% set article_classes = [
  'article-list-item',
  'node--type-' ~ node.bundle|clean_class,
  'node--view-mode-' ~ view_mode|clean_class,
  not node.isPublished() ? 'node--unpublished',
  node.isPromoted() ? 'node--promoted',
  node.isSticky() ? 'node--sticky',
] %}

<article{{ attributes.addClass(article_classes).setAttribute('data-article-id', article_id) }}>
  {% if node.field_image is not empty %}
    <div
      class="article-list-item__media"
      data-jurenites-article-image-transition="article-image-{{ article_id }}"
    >
      {{ content.field_image }}
    </div>
  {% endif %}

  <div class="article-list-item__body">
    {{ title_prefix }}
    {% if label %}
      <h2{{ title_attributes.addClass('article-list-item__title').setAttribute('data-jurenites-article-title-transition', 'article-title-' ~ article_id) }}>
        <a class="article-list-item__title-link" href="{{ url }}" rel="bookmark">{{ label }}</a>
      </h2>
    {% endif %}
    {{ title_suffix }}

    <div{{ content_attributes.addClass('article-list-item__content') }}>
      {{ content|without(
        'field_image',
        'field_consumption_time_minutes',
        'field_youtube_channel_avatar',
        'field_youtube_creator_name',
        'field_youtube_creator_url',
        'field_youtube_published_date',
        'field_youtube_video',
      ) }}
    </div>

    {% if display_submitted %}
      <footer class="article-list-item__meta">
        {% if node.field_youtube_video is not empty and youtube_author_name %}
          {% include '@jurenites_theme/components/author-byline.html.twig' with {
            byline_label: 'Video creator'|t,
            author_avatar_image: youtube_author_avatar,
            author_avatar_initials: youtube_author_initials,
            avatar_size: 'small',
            author_name_text: youtube_author_name,
            author_url: youtube_author_url,
            published_date_iso: youtube_published_date_iso,
            published_date_markup: youtube_published_date_text,
            date_value_kind: 'elapsed-time',
            date_display_variant: 'date-day',
            reading_time_minutes: reading_time_minutes,
            reading_time_label: reading_time_label,
          } only %}
        {% else %}
          {% include '@jurenites_theme/components/author-byline.html.twig' with {
            author_avatar_image: author_picture,
            author_avatar_initials: author_initials,
            author_name_markup: author_name,
            published_date_iso: submitted_date_iso,
            published_date_markup: submitted_date_text,
            reading_time_minutes: reading_time_minutes,
            reading_time_label: reading_time_label,
          } only %}
        {% endif %}
      </footer>
    {% endif %}
  </div>
</article>
