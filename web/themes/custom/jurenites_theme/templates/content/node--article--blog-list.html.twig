{#
/**
 * @file
 * Article presentation used by the Blog listing.
 */
#}
{% set article_id = node.id %}
{% set article_classes = [
  'article-list-item',
  'node--type-' ~ node.bundle|clean_class,
  'node--view-mode-' ~ view_mode|clean_class,
  not node.isPublished() ? 'node--unpublished',
  node.isPromoted() ? 'node--promoted',
  node.isSticky() ? 'node--sticky',
] %}

<article{{ attributes.addClass(article_classes).setAttribute('data-article-id', article_id) }}>
  {% if node.field_youtube_video is not empty and node.field_image is not empty %}
    <div class="article-list-item__media" style="view-transition-name: article-image-{{ article_id }}">
      {{ content.field_image }}
    </div>
  {% endif %}

  <div class="article-list-item__body">
    {{ title_prefix }}
    {% if label %}
      <h2{{ title_attributes.addClass('article-list-item__title').setAttribute('style', 'view-transition-name: article-title-' ~ article_id) }}>
        <a class="article-list-item__title-link" href="{{ url }}" rel="bookmark">{{ label }}</a>
      </h2>
    {% endif %}
    {{ title_suffix }}

    <div{{ content_attributes.addClass('article-list-item__content') }}>
      {{ content|without('field_image') }}
    </div>

    {% if display_submitted %}
      <footer class="article-list-item__meta">
        {% include '@jurenites_theme/components/avatar.html.twig' with {
          avatar_image: author_picture,
          avatar_initials: author_initials,
        } only %}
        <div{{ author_attributes.addClass('article-list-item__meta-details') }}>
          {% trans %}Written by {{ author_name }} on{% endtrans %}
          <time class="date-display date-display--month-day-year date-display--date-day" datetime="{{ submitted_date_iso }}">{{ submitted_date_text }}</time>
        </div>
      </footer>
    {% endif %}
  </div>
</article>
