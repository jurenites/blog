<article{{ attributes.addClass('project-card') }}>
  {% if content.field_image %}
    <div class="project-card__media">{{ content.field_image }}</div>
  {% endif %}
  <div class="project-card__body">
    <a class="project-card__title text-link" href="{{ url }}">{{ label }}</a>
    {% if content.field_tags %}
      <div class="project-card__tag-list">{{ content.field_tags }}</div>
    {% endif %}
  </div>
</article>
