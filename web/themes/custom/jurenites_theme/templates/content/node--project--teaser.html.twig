{% import '@jurenites_theme/components/card-loading.html.twig' as card_loading %}
<article{{ attributes.addClass('project-card') }} {{ card_loading.loading_attributes('project-card') }}>
  {{ title_prefix }}
  {{ title_suffix }}
  {% if content.field_image %}
    <div class="project-card__media" data-jurenites-article-image-transition="project-image-{{ node.id }}">{{ content.field_image }}</div>
  {% endif %}
  <div class="project-card__body">
    <a class="project-card__title text-link" href="{{ url }}">{{ label }}</a>
    {% if content.field_tags %}
      <div class="project-card__tag-list">{{ content.field_tags }}</div>
    {% endif %}
  </div>
</article>
