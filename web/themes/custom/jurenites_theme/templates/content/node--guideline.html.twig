{% set guideline_detail_classes = [
  'guideline-detail',
  'guideline-detail--' ~ guideline_section|clean_class,
  not node.isPublished() ? 'node--unpublished',
] %}

<article{{ attributes.addClass(guideline_detail_classes) }}>
  {{ title_prefix }}
  {{ title_suffix }}

  {% if guideline_summary %}
    <div class="guideline-detail__summary">{{ guideline_summary }}</div>
  {% endif %}

  {% if guideline_section == 'logo_icon' %}
    <section class="guideline-specimen guideline-logo-specimen" aria-labelledby="guideline-logo-specimen-heading">
      <header class="guideline-specimen__header">
        <h2 id="guideline-logo-specimen-heading" class="guideline-specimen__title">{{ 'Current icon'|t }}</h2>
        <p class="guideline-specimen__description">{{ 'The rendered examples below use the same SVG file as the website header.'|t }}</p>
      </header>
      <div class="guideline-logo-specimen__grid">
        <figure class="guideline-logo-specimen__surface guideline-logo-specimen__surface--dark">
          <img class="guideline-logo-specimen__image" src="{{ guideline_logo_url }}" alt="{{ 'Jurenites pixel wordmark icon'|t }}" />
          <figcaption>{{ 'Dark surface'|t }}</figcaption>
        </figure>
        <figure class="guideline-logo-specimen__surface guideline-logo-specimen__surface--light">
          <img class="guideline-logo-specimen__image" src="{{ guideline_logo_url }}" alt="{{ 'Jurenites pixel wordmark icon'|t }}" />
          <figcaption>{{ 'Light surface'|t }}</figcaption>
        </figure>
      </div>
      <p class="guideline-logo-specimen__source">
        <span>{{ 'Source asset'|t }}</span>
        <code>web/themes/custom/jurenites_theme/logo.svg</code>
      </p>
    </section>
  {% elseif guideline_section == 'color' and guideline_color_groups %}
    <section class="guideline-specimen guideline-color-palette" aria-labelledby="guideline-color-palette-heading">
      <header class="guideline-specimen__header">
        <h2 id="guideline-color-palette-heading" class="guideline-specimen__title">{{ 'Token palette'|t }}</h2>
        <p class="guideline-specimen__description">{{ 'These values are read from the generated record of src/token/tokens.yaml.'|t }}</p>
      </header>
      {% for color_group in guideline_color_groups %}
        <section class="guideline-color-palette__group" aria-labelledby="guideline-color-group-{{ loop.index }}">
          <h3 id="guideline-color-group-{{ loop.index }}" class="guideline-color-palette__group-title">{{ color_group.group_label }}</h3>
          <div class="guideline-color-palette__grid">
            {% for color_token in color_group.color_tokens %}
              {% include '@jurenites_theme/components/guideline-color-swatch.html.twig' with {
                background_class: color_token.background_class,
                token_label: color_token.token_label,
                token_name: color_token.token_name,
                token_value: color_token.token_value,
              } only %}
            {% endfor %}
          </div>
        </section>
      {% endfor %}
    </section>
  {% endif %}

  <div{{ content_attributes.addClass('guideline-detail__content') }}>
    {{ content.body }}
  </div>
</article>
