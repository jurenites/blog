{#
/**
 * @file
 * Article teaser used by Drupal listings.
 */
#}
{% set article_id = node.id %}

<div class="article-teaser">
  {% if content.game_of_life or content.field_image %}
    <div
      class="article-teaser__media{{ content.game_of_life ? ' article-teaser__media--game-of-life' }}"
      data-jurenites-article-image-transition="article-image-{{ article_id }}"
    >
      {{ content.game_of_life ? content.game_of_life : content.field_image }}
    </div>
  {% endif %}

  {{ title_prefix }}
  {% if label %}
    <h3{{ title_attributes.addClass('article-teaser__title').setAttribute('data-jurenites-article-title-transition', 'article-title-' ~ article_id) }}>
      <a class="article-teaser__title-link" href="{{ url }}" rel="bookmark">{{ label }}</a>
    </h3>
  {% endif %}
  {% if node.field_tags is not empty %}
    {{ content.field_tags }}
  {% endif %}
  {{ title_suffix }}

  <div{{ content_attributes.addClass('article-teaser__content') }}>
    {{ content|without('game_of_life', 'field_consumption_time_minutes', 'field_image', 'field_tags') }}
  </div>

  {% if display_submitted %}
    <footer class="article-teaser__meta">
      {% include '@jurenites_theme/components/author-byline.html.twig' with {
        author_prefix_text: 'Written by'|t,
        author_avatar_image: author_picture,
        author_avatar_initials: author_initials,
        avatar_size: 'medium',
        author_name_attributes: author_attributes,
        author_name_markup: author_name,
        published_date_iso: submitted_date_iso,
        published_date_markup: submitted_date_text,
        reading_time_minutes: reading_time_minutes,
        reading_time_label: reading_time_label,
        byline_layout: 'stacked',
      } only %}
    </footer>
  {% endif %}
</div>
