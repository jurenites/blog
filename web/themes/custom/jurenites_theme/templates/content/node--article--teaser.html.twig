{#
/**
 * @file
 * Article teaser used by Drupal listings.
 */
#}
{% set article_id = node.id %}
{% set article_classes = [
  'article-teaser',
  'node--type-' ~ node.bundle|clean_class,
  'node--view-mode-' ~ view_mode|clean_class,
  not node.isPublished() ? 'node--unpublished',
  node.isPromoted() ? 'node--promoted',
  node.isSticky() ? 'node--sticky',
] %}

<article{{ attributes.addClass(article_classes).setAttribute('data-article-id', article_id) }}>
  {% if content.field_image %}
    <div class="article-teaser__media">
      {{ content.field_image }}
    </div>
  {% endif %}

  {{ title_prefix }}
  {% if label %}
    <h3{{ title_attributes.addClass('article-teaser__title') }}>
      <a class="article-teaser__title-link" href="{{ url }}" rel="bookmark">{{ label }}</a>
    </h3>
  {% endif %}
  {{ title_suffix }}

  <div{{ content_attributes.addClass('article-teaser__content') }}>
    {{ content|without('field_consumption_time_minutes', 'field_image') }}
  </div>

  {% if display_submitted %}
    <footer class="article-teaser__meta">
      {% include '@jurenites_theme/components/avatar.html.twig' with {
        avatar_image: author_picture,
        avatar_initials: author_initials,
      } only %}
      <div{{ author_attributes.addClass('article-teaser__meta-details') }}>
        {% trans %}Written by {{ author_name }} on{% endtrans %}
        <time class="date-display date-display--month-day-year date-display--date-day" datetime="{{ submitted_date_iso }}">{{ submitted_date_text }}</time>
        {% if reading_time_minutes and reading_time_label %}
          <span class="article-teaser__meta-separator" aria-hidden="true">&middot;</span>
          {% include '@jurenites_theme/components/consumption-time.html.twig' with {
            consumption_time_minutes: reading_time_minutes,
            consumption_time_label: reading_time_label,
          } only %}
        {% endif %}
      </div>
    </footer>
  {% endif %}
</article>
