{# One repeatable statistic tile inside the parent Numeric Values section. #}
<li{{ attributes.addClass('numeric-values__tile') }}>
  <div class="numeric-values__tile-content">
    {% if numeric_icon_url %}
      <img class="numeric-values__icon" src="{{ numeric_icon_url }}" alt="">
    {% endif %}
    <h2 class="numeric-values__number{% if role_selector %} role-slider__number{% endif %}">{{ numeric_value_text }}</h2>
    {% if role_selector %}
      <button class="numeric-values__description role-slider__tab" type="button" id="{{ role_selector.button_id }}" aria-controls="{{ role_selector.panel_id }}">
        <span class="role-slider__prefix">{{ 'As a'|t }}</span> {{ role_selector.role_heading }}
      </button>
    {% else %}
      <p class="numeric-values__description">{{ paragraph.field_numeric_description.value }}</p>
    {% endif %}
    {% if paragraph.field_numeric_caption.value or numeric_caption_link_url %}
      <p class="numeric-values__caption">
        {{ paragraph.field_numeric_caption.value }}
        {% if numeric_caption_link_url %}
          <a class="numeric-values__caption-link" href="{{ numeric_caption_link_url }}"{% if numeric_caption_link_external %} target="_blank" rel="noopener noreferrer" aria-label="{{ numeric_caption_link_label }} ({{ 'opens in a new tab'|t }})"{% endif %}>
            <span>{{ numeric_caption_link_label }}</span>
            {% if numeric_caption_link_external %}
              {% include '@jurenites_theme/components/icon.html.twig' with {
                icon_name: 'external-link',
                icon_class: 'footer-navigation__external-mark numeric-values__caption-external-mark'
              } only %}
            {% endif %}
          </a>
        {% endif %}
      </p>
    {% endif %}
    {% if numeric_link_url %}
      <a class="numeric-values__link" href="{{ numeric_link_url }}">{{ numeric_link_label }}</a>
    {% endif %}
  </div>
</li>
