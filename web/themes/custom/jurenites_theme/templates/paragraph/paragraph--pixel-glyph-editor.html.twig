{% set component_id = 'pixel-glyph-editor-' ~ paragraph.uuid.value|clean_id %}
<section class="pixel-glyph-editor" data-jurenites-pixel-glyph-editor aria-labelledby="{{ component_id }}-title">
  <header class="pixel-glyph-editor__header">
    <p class="pixel-glyph-editor__eyebrow">{{ 'Interactive grid'|t }}</p>
    <h2 id="{{ component_id }}-title">{{ 'Draw a 5×5 glyph'|t }}</h2>
    <p>{{ 'Click, tap, use Space or Enter, or drag across cells. Reloading starts from a blank grid.'|t }}</p>
  </header>
  <div class="pixel-glyph-editor__workspace">
    <div class="pixel-glyph-editor__controls">
      <div class="pixel-glyph-editor__grid" role="group" aria-label="{{ '5 by 5 pixel drawing grid'|t }}">
        {% for cell_index in 0..24 %}
          {% set row_number = (cell_index / 5)|round(0, 'floor') + 1 %}
          {% set column_number = (cell_index % 5) + 1 %}
          <button class="pixel-glyph-editor__cell" type="button" data-pixel-cell="{{ cell_index }}" aria-label="{{ 'Row @row, column @column'|t({'@row': row_number, '@column': column_number}) }}" aria-pressed="false"></button>
        {% endfor %}
      </div>
      <p class="pixel-glyph-editor__status" data-pixel-status role="status">{{ '0 of 25 pixels filled'|t }}</p>
    </div>
    <div class="pixel-glyph-editor__preview-block">
      <h3>{{ 'Preview'|t }}</h3>
      <div class="pixel-glyph-editor__preview" aria-label="{{ 'Enlarged glyph preview'|t }}">
        {% for cell_index in 0..24 %}
          <span class="pixel-glyph-editor__preview-cell" data-pixel-preview-cell aria-hidden="true"></span>
        {% endfor %}
      </div>
    </div>
  </div>
</section>
