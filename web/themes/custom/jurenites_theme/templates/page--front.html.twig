<div class="jurenites-front-page">
  <div
    class="section-background-canvas background-fx-canvas"
    data-jurenites-gradient-background
    aria-hidden="true"
  ></div>

  <div class="layout-container">
    <a href="#main-content" class="skip-to-content button button--primary">
      {{ 'Skip to main content'|t }}
    </a>

    {% if page.header %}
      <header role="banner">
        {{ page.header }}
      </header>
    {% endif %}

    {% if page.primary_menu %}
      <nav role="navigation" aria-label="{{ 'Primary menu'|t }}">
        {{ page.primary_menu }}
      </nav>
    {% endif %}

    {# Skip-link target: keep id on <main>, never use an <a> without href. #}
    <main id="main-content" role="main" tabindex="-1">
      {{ page.content }}
    </main>

    {% if page.footer %}
      <footer role="contentinfo">
        {{ page.footer }}
      </footer>
    {% endif %}
  </div>
</div>
