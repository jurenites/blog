<div class="jurenites-front-page">
  <div class="layout-container">
    {% include '@jurenites_theme/components/site-header.html.twig' with {
      site_branding: site_branding,
      main_navigation: main_navigation,
      language_options: language_options,
    } only %}

    {% if page.header %}
      {{ page.header }}
    {% endif %}

    {% if page.primary_menu %}
      {{ page.primary_menu }}
    {% endif %}

    {# Skip-link target: keep id on <main>, never use an <a> without href. #}
    <main id="main-content" role="main" tabindex="-1">
      {{ page.content }}
    </main>

    {% if page.footer %}
      <footer class="site-footer" role="contentinfo">
        {{ page.footer }}
      </footer>
    {% endif %}
  </div>
</div>
