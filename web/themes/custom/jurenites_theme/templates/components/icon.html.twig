<icon class="icon{% if icon_class %} {{ icon_class }}{% endif %}" name="{{ icon_name }}" data-icon-name="{{ icon_name }}" aria-hidden="true">
  <svg class="icon__svg" viewBox="0 0 24 24" width="24" height="24" fill="none">
    <use href="{{ icon_asset_base_url }}/{{ icon_name }}.svg"></use>
  </svg>
</icon>
