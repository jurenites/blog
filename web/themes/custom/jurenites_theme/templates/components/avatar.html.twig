{#
/**
 * @file
 * Shared Avatar component with a native Drupal author picture and initials fallback.
 */
#}
{% set resolved_avatar_size = avatar_size|default('medium') %}
<div class="avatar avatar--{{ resolved_avatar_size }}" data-jurenites-avatar>
  <span class="avatar__initials" aria-hidden="true">{{ avatar_initials }}</span>
  {% if avatar_image %}
    <div class="avatar__image" data-jurenites-avatar-image>{{ avatar_image }}</div>
  {% endif %}
</div>
