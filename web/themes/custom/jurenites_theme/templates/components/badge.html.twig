{% set badge_classes = ['badge'] %}
{% if numeric_style %}
  {% set badge_classes = badge_classes|merge(['badge--numeric']) %}
{% endif %}
{% if color_variant != 'neutral' %}
  {% set badge_classes = badge_classes|merge(['badge--' ~ color_variant]) %}
{% endif %}
<span{{ attributes.addClass(badge_classes) }}>{{ badge_label }}</span>
