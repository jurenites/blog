{# Shared source identity composed from Avatar, publication date, and topics. #}
<aside class="author-byline" aria-label="{{ byline_label|default('Article author'|t) }}">
  {% include '@jurenites_theme/components/avatar.html.twig' with {
    avatar_image: author_avatar_image,
    avatar_initials: author_avatar_initials,
    avatar_size: avatar_size|default('medium'),
  } only %}
  <div class="author-byline__identity">
    <span class="author-byline__name">
      {% if author_name_markup %}
        {{ author_name_markup }}
      {% elseif author_url %}
        <a href="{{ author_url }}" rel="external noopener">{{ author_name_text }}</a>
      {% else %}
        {{ author_name_text }}
      {% endif %}
    </span>
    {% if published_date_markup or (reading_time_minutes and reading_time_label) %}
      <span class="author-byline__details">
      {% if published_date_markup %}
        &nbsp;
        <span class="author-byline__separator" aria-hidden="true">&middot;</span>
        <time class="date-display date-display--{{ date_value_mode|default('month-day-year') }} date-display--{{ date_display_variant|default('date-day') }}" datetime="{{ published_date_iso }}">{{ published_date_markup }}</time>
      {% endif %}
      {% if reading_time_minutes and reading_time_label %}
        {% if published_date_markup %}
          <span class="author-byline__separator" aria-hidden="true">&middot;</span>
        {% endif %}
        <span class="author-byline__reading-time date-display">
          <span class="author-byline__reading-time-minutes">{{ reading_time_minutes }}</span>
          <span class="author-byline__reading-time-label">{{ reading_time_label }}</span>
        </span>
      {% endif %}
      </span>
    {% endif %}
  </div>
  {% if topic_content %}
    <div class="author-byline__topics">{{ topic_content }}</div>
  {% endif %}
</aside>
