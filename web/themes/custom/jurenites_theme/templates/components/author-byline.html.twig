{# Shared full-article author identity composed from Avatar, date, and topics. #}
<aside class="author-byline" aria-label="{{ 'Article author'|t }}">
  {% include '@jurenites_theme/components/avatar.html.twig' with {
    avatar_image: author_avatar_image,
    avatar_initials: author_avatar_initials,
    avatar_size: 'medium',
  } only %}
  <div class="author-byline__identity">
    <p class="author-byline__name">{{ author_name_markup }}</p>
    <div class="author-byline__details">
      <time class="date-display date-display--month-day-year date-display--date-day" datetime="{{ published_date_iso }}">{{ published_date_markup }}</time>
      {% if reading_time_markup %}
        <span class="author-byline__separator" aria-hidden="true">&middot;</span>
        <span class="author-byline__reading-time">{{ reading_time_markup }}</span>
      {% endif %}
    </div>
  </div>
  {% if topic_content %}
    <div class="author-byline__topics">{{ topic_content }}</div>
  {% endif %}
</aside>
