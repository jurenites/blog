<article class="guideline-color-swatch">
  <span class="guideline-color-swatch__sample {{ background_class }}" aria-hidden="true"></span>
  <span class="guideline-color-swatch__information">
    <strong class="guideline-color-swatch__label">{{ token_label }}</strong>
    <code class="guideline-color-swatch__value">{{ token_value }}</code>
    <code class="guideline-color-swatch__name">--{{ token_name }}</code>
  </span>
</article>
