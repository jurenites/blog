{{ editorial_copy_cache }}
<div{{ attributes.addClass('site-header__branding') }}>
{{ title_prefix }}
  <a class="site-header__brand" href="{{ path('<front>') }}" rel="home" aria-label="{{ '@name home'|t({'@name': brand_display_name}) }}">
    <span class="site-header__brand-name" aria-hidden="true">
      <span class="site-header__brand-name-short">
        {% for name_word in brand_name_words %}
          <span class="site-header__brand-name-word site-header__brand-name-word--{{ loop.first ? 'first' : 'last' }}">
            <span class="site-header__brand-name-initial">{{ name_word.initial }}</span>
            <span class="site-header__brand-name-remainder">{% for name_letter in name_word.letters %}<span class="site-header__brand-name-letter">{{ name_letter }}</span>{% endfor %}</span>
          </span>
        {% endfor %}
      </span>
    </span>
  </a>
{{ title_suffix }}
</div>
