{# Editable Drupal Content Block; the close icon is available before enhancement. #}
<section{{ attributes.addClass('cookie-policy-notice') }}
  aria-labelledby="cookie-policy-notice-heading"
  data-jurenites-cookie-policy-notice
  hidden
>
  <div class="cookie-policy-notice__content">
    {{ title_prefix }}
    {% if label %}
      <h2 class="cookie-policy-notice__heading" id="cookie-policy-notice-heading">{{ label }}</h2>
    {% endif %}
    {{ title_suffix }}
    {{ content }}
  </div>
  <button class="button button--ghost cookie-policy-notice__close" type="button" aria-label="{{ 'Close cookie notice'|t }}">
    {% include '@jurenites_theme/components/icon.html.twig' with {
      icon_name: 'cross-big', icon_class: 'cookie-policy-notice__close-icon'
    } only %}
  </button>
</section>
