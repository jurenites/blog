{{ footer_navigation_cache }}
{% if items %}
  <div class="footer-navigation">
    <div class="footer-navigation__columns">
      {% for footer_column in footer_columns %}
        <nav aria-label="{{ footer_column.title }}">
          <h2 class="footer-navigation__heading">{{ footer_column.title }}</h2>
          {% include '@jurenites_theme/navigation/footer-menu-items.html.twig' with { footer_items: footer_column.below } %}
        </nav>
      {% endfor %}
    </div>
    <div class="footer-navigation__bottom-row">
      <p class="footer-navigation__rights-message">{{ 'No rights reserved'|t }} {{ 'now'|date('Y') }}</p>
      {{ footer_legal_menu }}
      {% for footer_group in footer_bottom_groups %}
        <nav class="footer-navigation__legal-navigation" aria-label="{{ footer_group.title }}">
          {% include '@jurenites_theme/navigation/footer-menu-items.html.twig' with { footer_items: footer_group.below, list_class: 'footer-navigation__legal-list' } %}
        </nav>
      {% endfor %}
      {% if footer_ungrouped_items %}
        {% include '@jurenites_theme/navigation/footer-menu-items.html.twig' with { footer_items: footer_ungrouped_items, list_class: 'footer-navigation__legal-list' } %}
      {% endif %}
    </div>
  </div>
{% endif %}
