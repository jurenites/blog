{% if items %}
  <ul class="site-header__links">
    {% for menu_item in items %}
      {% set link_attributes = {'class': ['site-header__link']} %}
      {% if menu_item.in_active_trail %}
        {% set link_attributes = link_attributes|merge({
          'class': ['site-header__link', 'is-active'],
          'aria-current': 'page',
        }) %}
      {% endif %}
      {% set is_home_link = (menu_item.url.isRouted and menu_item.url.routeName == '<front>') or menu_item.url.toString == path('<front>') %}
      <li class="site-header__item{% if is_home_link %} site-header__item--home{% endif %}">
        {{ link(menu_item.title, menu_item.url, link_attributes) }}
      </li>
    {% endfor %}
  </ul>
{% endif %}
