{{ breadcrumb_navigation_cache }}
{% if article_back_url %}
  <nav class="breadcrumbs" aria-label="{{ 'Article navigation'|t }}">
    <a class="breadcrumbs__back-link" href="{{ article_back_url }}">
      {% include '@jurenites_theme/components/icon.html.twig' with {
        icon_name: 'arrow-left',
        icon_class: 'breadcrumbs__back-icon',
        icon_asset_base_url: icon_asset_base_url,
      } only %}
      <span>{{ 'Back'|t }}</span>
    </a>
  </nav>
{% elseif breadcrumb|length > 1 %}
  <nav class="breadcrumbs" aria-label="{{ 'Breadcrumb'|t }}">
    <ol class="breadcrumbs__list">
      {% for breadcrumb_item in breadcrumb %}
        <li class="breadcrumbs__item"{% if loop.last %} aria-current="page"{% endif %}>
          {% if breadcrumb_item.url %}
            <a class="breadcrumbs__link" href="{{ breadcrumb_item.url }}">{{ breadcrumb_item.text }}</a>
          {% else %}
            <span class="breadcrumbs__current">{{ breadcrumb_item.text }}</span>
          {% endif %}
        </li>
      {% endfor %}
    </ol>
  </nav>
{% endif %}
