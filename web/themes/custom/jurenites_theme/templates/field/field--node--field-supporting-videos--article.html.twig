{# Share responsive loading behavior with the main Video player. #}
<div class="article-supporting-videos">
  {% for video_item in items %}
    <div class="article-supporting-videos__item">
      {% include '@jurenites_theme/components/video-loader.html.twig' with {
        video_content: video_item.content,
      } only %}
    </div>
  {% endfor %}
</div>
