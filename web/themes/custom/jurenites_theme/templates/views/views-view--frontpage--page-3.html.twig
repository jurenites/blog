{# Videos View page with an optional selected-tag summary and clear action. #}
{% set view_classes = [dom_id ? 'js-view-dom-id-' ~ dom_id] %}
<div{{ attributes.addClass(view_classes).setAttribute('data-video-listing', '') }}>
  {{ title_prefix }}
  {{ title }}
  {{ title_suffix }}

  <p class="video-grid__introduction">{{ 'These are videos I’ve enjoyed and think are worth watching to learn something new. Some explore topics I haven’t covered elsewhere on this site.'|t }}</p>

  {% if selected_tag_label %}
    <aside class="blog-filter" aria-label="{{ 'Current Videos filter'|t }}">
      <span class="blog-filter__label">{{ 'Selected tag'|t }}</span>
      <a class="chip chip--accent blog-filter__clear" href="{{ clear_tag_url }}" aria-label="{{ 'Remove tag filter: @tag'|t({'@tag': selected_tag_label}) }}">
        <span>{{ selected_tag_label }}</span>
        {% include '@jurenites_theme/components/icon.html.twig' with {
          icon_name: 'cross-big',
          icon_class: 'blog-filter__clear-icon',
          icon_asset_base_url: icon_asset_base_url,
        } only %}
      </a>
    </aside>
  {% endif %}

  {% if header %}
    <header>{{ header }}</header>
  {% endif %}

  {{ exposed }}
  {{ attachment_before }}

  {% if rows %}
    {{ rows }}
  {% elseif selected_tag_label %}
    <p class="article-list__empty">{{ 'No videos have been added for this interest yet.'|t }}</p>
  {% elseif empty %}
    {{ empty }}
  {% endif %}
  <p class="video-grid__status" data-video-status role="status" aria-live="polite" aria-atomic="true" hidden
    data-loading-text="{{ 'Loading more videos…'|t }}"
    data-loaded-text="{{ 'More videos loaded.'|t }}"
    data-complete-text="{{ 'All videos loaded.'|t }}"
    data-error-text="{{ 'Could not load more videos. Use the pagination below to continue.'|t }}"></p>
  <div data-video-pager>{{ pager }}</div>

  {{ attachment_after }}
  {{ more }}

  {% if footer %}
    <footer>{{ footer }}</footer>
  {% endif %}

  {{ feed_icons }}
</div>
