<?php

/**
 * @file
 * Installation hooks for jurenites Admin.
 */

/**
 * Enables the site-owned Article comment policy on first installation.
 */
function jurenites_admin_install(): void {
  jurenites_admin_configure_article_comments();
  jurenites_admin_configure_editor_typography();
  \Drupal::service('module_installer')->install(['jurenites_inline_media']);
}
