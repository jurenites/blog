<?php

/**
 * @file
 * Applies project-specific administration behavior and Gin branding.
 */

use Drupal\comment\CommentingStatus;
use Drupal\comment\CommentInterface;
use Drupal\ckeditor5\HTMLRestrictions;
use Drupal\Core\Entity\EntityInterface;
use Drupal\Core\Entity\FieldableEntityInterface;
use Drupal\Core\Extension\Extension;
use Drupal\Core\Form\FormStateInterface;
use Drupal\editor\Entity\Editor;
use Drupal\field\Entity\FieldConfig;
use Drupal\filter\Entity\FilterFormat;
use Drupal\user\Entity\Role;
use Drupal\user\RoleInterface;

/**
 * Returns the public typography role labels from the design system.
 */
function jurenites_admin_editor_typography_roles(): array {
  return [
    'headline-1' => 'Headline 1',
    'headline-2' => 'Headline 2',
    'headline-3' => 'Headline 3',
    'headline-4' => 'Headline 4',
    'headline-5' => 'Headline 5',
    'headline-6' => 'Headline 6',
    'subtitle-1' => 'Subtitle 1',
    'subtitle-2' => 'Subtitle 2',
    'eyebrow' => 'Eyebrow',
    'body' => 'Body',
    'body-2' => 'Body 2',
    'link' => 'Link',
    'caption' => 'Caption',
    'code' => 'Code',
    'machine-readable' => 'Machine readable',
    'badge' => 'Badge',
    'overline' => 'Overline',
    'numeric-display' => 'Numeric display',
  ];
}

/**
 * Returns the token-backed typography styles exposed in CKEditor.
 */
function jurenites_admin_editor_typography_styles(): array {
  $typography_styles = [];
  foreach (jurenites_admin_editor_typography_roles() as $role_name => $role_label) {
    $typography_styles[] = [
      'label' => $role_label,
      'element' => sprintf(
        '<span class="u-typography-%s">',
        $role_name,
      ),
    ];
  }

  return $typography_styles;
}

/**
 * Adds the project typography list to CKEditor-backed body text formats.
 */
function jurenites_admin_configure_editor_typography(): int {
  $typography_styles = jurenites_admin_editor_typography_styles();
  $typography_classes = array_map(
    static fn(string $role_name): string => 'u-typography-' . $role_name,
    array_keys(jurenites_admin_editor_typography_roles()),
  );
  $updated_editor_count = 0;

  foreach (['basic_html', 'full_html'] as $editor_format_id) {
    $text_editor = Editor::load($editor_format_id);
    if ($text_editor === NULL || $text_editor->getEditor() !== 'ckeditor5') {
      continue;
    }

    $editor_settings = $text_editor->getSettings();
    $toolbar_items = $editor_settings['toolbar']['items'] ?? [];
    if (!in_array('style', $toolbar_items, TRUE)) {
      $heading_position = array_search('heading', $toolbar_items, TRUE);
      $style_position = $heading_position === FALSE
        ? count($toolbar_items)
        : $heading_position + 1;
      array_splice($toolbar_items, $style_position, 0, ['style']);
    }
    $editor_settings['toolbar']['items'] = $toolbar_items;

    $existing_styles = $editor_settings['plugins']['ckeditor5_style']['styles'] ?? [];
    $unrelated_styles = array_values(array_filter(
      $existing_styles,
      static fn(array $existing_style): bool => !str_contains(
        $existing_style['element'] ?? '',
        'u-typography-',
      ),
    ));
    $editor_settings['plugins']['ckeditor5_style']['styles'] = array_merge(
      $unrelated_styles,
      $typography_styles,
    );

    $text_editor->setSettings($editor_settings)->save();
    $updated_editor_count++;

    $text_format = FilterFormat::load($editor_format_id);
    if ($text_format === NULL || !$text_format->filters('filter_html')->status) {
      continue;
    }

    $filter_configuration = $text_format
      ->filters('filter_html')
      ->getConfiguration();
    $current_restrictions = HTMLRestrictions::fromString(
      $filter_configuration['settings']['allowed_html'],
    );
    $typography_restrictions = HTMLRestrictions::fromString(sprintf(
      '<span class="%s">',
      implode(' ', $typography_classes),
    ));
    $filter_configuration['settings']['allowed_html'] = $current_restrictions
      ->merge($typography_restrictions)
      ->toFilterHtmlAllowedTagsString();
    $text_format
      ->setFilterConfig('filter_html', $filter_configuration)
      ->save();
  }

  return $updated_editor_count;
}

/**
 * Implements hook_entity_presave().
 */
function jurenites_admin_entity_presave(EntityInterface $saved_entity): void {
  if (!$saved_entity instanceof FieldableEntityInterface) {
    return;
  }

  $field_definitions = $saved_entity->getFieldDefinitions();
  foreach ($field_definitions as $field_name => $field_definition) {
    $is_comment_field = $field_definition->getType() === 'comment';
    if (!$is_comment_field || $saved_entity->get($field_name)->isEmpty()) {
      continue;
    }

    $is_article_comment = $saved_entity->getEntityTypeId() === 'node'
      && $saved_entity->bundle() === 'article'
      && $field_name === 'comment';
    $saved_entity->get($field_name)->status = $is_article_comment
      ? CommentingStatus::Open->value
      : CommentingStatus::Closed->value;
  }
}

/**
 * Keeps Article comments public while reserving authorship for content editors.
 */
function jurenites_admin_configure_article_comments(): int {
  $comment_field = FieldConfig::loadByName('node', 'article', 'comment');
  if ($comment_field !== NULL) {
    $default_values = $comment_field->getDefaultValueLiteral();
    $default_values[0]['status'] = CommentingStatus::Open->value;
    $comment_field
      ->setDefaultValue($default_values)
      ->setSetting('anonymous', 0)
      ->save();
  }

  $comment_body_field = FieldConfig::loadByName('comment', 'comment', 'comment_body');
  if ($comment_body_field !== NULL) {
    $comment_body_field
      ->setSetting('allowed_formats', ['restricted_html'])
      ->save();
  }

  $view_permissions = ['access comments'];
  foreach ([RoleInterface::ANONYMOUS_ID, RoleInterface::AUTHENTICATED_ID] as $role_id) {
    $viewer_role = Role::load($role_id);
    if ($viewer_role !== NULL) {
      foreach ($view_permissions as $view_permission) {
        $viewer_role->grantPermission($view_permission);
      }
      foreach (['post comments', 'skip comment approval', 'edit own comments'] as $posting_permission) {
        $viewer_role->revokePermission($posting_permission);
      }
      $viewer_role->save();
    }
  }

  $content_editor_role = Role::load('content_editor');
  if ($content_editor_role !== NULL) {
    foreach ([
      'access comments',
      'post comments',
      'skip comment approval',
      'edit own comments',
      'use text format restricted_html',
    ] as $editor_permission) {
      $content_editor_role->grantPermission($editor_permission);
    }
    $content_editor_role->save();
  }

  $article_storage = \Drupal::entityTypeManager()->getStorage('node');
  $article_ids = \Drupal::entityQuery('node')
    ->accessCheck(FALSE)
    ->condition('type', 'article')
    ->execute();

  $updated_article_count = 0;
  foreach ($article_storage->loadMultiple($article_ids) as $article_entity) {
    if (!$article_entity->hasField('comment')
      || (int) $article_entity->get('comment')->status === CommentingStatus::Open->value) {
      continue;
    }

    $article_entity->get('comment')->status = CommentingStatus::Open->value;
    $article_entity->save();
    $updated_article_count++;
  }

  return $updated_article_count;
}

/**
 * Implements hook_form_BASE_FORM_ID_alter() for native comment forms.
 */
function jurenites_admin_form_comment_form_alter(array &$comment_form, FormStateInterface $form_state, string $form_id): void {
  $comment_entity = $form_state->getFormObject()->getEntity();
  if (!$comment_entity instanceof CommentInterface) {
    return;
  }

  $commented_entity = $comment_entity->getCommentedEntity();
  if ($commented_entity?->getEntityTypeId() !== 'node'
    || $commented_entity->bundle() !== 'article') {
    return;
  }

  if (isset($comment_form['subject'])) {
    $comment_form['subject']['#access'] = FALSE;
  }
  $can_reassign_comment = !$comment_entity->isNew()
    && \Drupal::currentUser()->hasPermission('administer comments');
  if (isset($comment_form['author']) && !$can_reassign_comment) {
    $comment_form['author']['#access'] = FALSE;
  }
  if (isset($comment_form['comment_body']['widget'][0]['value'])) {
    $comment_form['comment_body']['widget'][0]['value']['#title'] = t('Comment');
    $comment_form['comment_body']['widget'][0]['value']['#maxlength'] = 5000;
  }
  $comment_form['#after_build'][] = 'jurenites_admin_hide_comment_format_help';
  if (isset($comment_form['actions']['preview'])) {
    $comment_form['actions']['preview']['#access'] = FALSE;
  }
  if (isset($comment_form['actions']['submit'])) {
    $comment_form['actions']['submit']['#value'] = t('Post comment');
  }
}

/**
 * Hides the fixed text-format controls from the Article comment form.
 */
function jurenites_admin_hide_comment_format_help(array $comment_form, FormStateInterface $form_state): array {
  if (isset($comment_form['comment_body']['widget'][0]['format'])) {
    $comment_form['comment_body']['widget'][0]['format']['#access'] = FALSE;
  }

  return $comment_form;
}

/**
 * Implements hook_system_info_alter().
 */
function jurenites_admin_system_info_alter(array &$extension_info, Extension $extension_file, string $extension_type): void {
  if ($extension_type === 'theme' && $extension_file->getName() === 'claro') {
    $extension_info['hidden'] = TRUE;
  }
}

/**
 * Implements hook_page_attachments().
 */
function jurenites_admin_page_attachments(array &$page_attachments): void {
  $active_theme_name = \Drupal::theme()->getActiveTheme()->getName();
  $uses_gin_admin_theme = $active_theme_name === 'gin';
  $has_toolbar_access = \Drupal::currentUser()->hasPermission('access toolbar')
    || \Drupal::currentUser()->hasPermission('access navigation');
  $uses_gin_frontend_toolbar = $has_toolbar_access
    && \Drupal::moduleHandler()->moduleExists('gin_toolbar')
    && \Drupal::config('system.theme')->get('admin') === 'gin';

  if (!$uses_gin_admin_theme && !$uses_gin_frontend_toolbar) {
    return;
  }

  $page_attachments['#attached']['library'][] = 'jurenites_admin/gin-branding';
}
