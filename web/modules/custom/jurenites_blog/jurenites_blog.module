<?php

/**
 * @file
 * Article content helpers for the Jurenites Blog.
 */

use Drupal\Core\File\FileExists;
use Drupal\Core\File\FileSystemInterface;
use Drupal\Core\Form\FormStateInterface;
use Drupal\node\NodeInterface;
use Drupal\taxonomy\TermInterface;

/**
 * Adds primary YouTube uniqueness validation to Video nodes.
 */
function jurenites_blog_entity_bundle_field_info_alter(array &$field_definitions, \Drupal\Core\Entity\EntityTypeInterface $entity_type, $bundle_name): void {
  if ($entity_type->id() === 'node' && $bundle_name === 'video'
    && isset($field_definitions['field_youtube_video'])) {
    $field_definitions['field_youtube_video']->addConstraint('UniqueYoutubeVideo');
  }
}

/**
 * Uses direct YouTube players in existing oEmbed displays without a migration.
 */
function jurenites_blog_field_formatter_info_alter(array &$formatter_definitions): void {
  if (isset($formatter_definitions['oembed'])) {
    $formatter_definitions['oembed']['class'] = \Drupal\jurenites_blog\Plugin\Field\FieldFormatter\DirectYoutubeOEmbedFormatter::class;
  }
}

/**
 * Avoids fetching YouTube metadata just to select a Media template.
 */
function jurenites_blog_media_source_info_alter(array &$source_definitions): void {
  foreach ($source_definitions as &$source_definition) {
    if (($source_definition['class'] ?? '') === \Drupal\media\Plugin\media\Source\OEmbed::class) {
      $source_definition['class'] = \Drupal\jurenites_blog\Plugin\media\Source\LocalYoutubeOEmbed::class;
    }
  }
}

/**
 * Varies the shared branding before Drupal looks up the rendered block cache.
 */
function jurenites_blog_block_build_system_branding_block_alter(array &$block_build): void {
  $cache_metadata = \Drupal\Core\Cache\CacheableMetadata::createFromRenderArray($block_build);
  $cache_metadata->addCacheContexts(['route', 'url.query_args:tag', 'user.permissions']);
  $cache_metadata->addCacheTags(['taxonomy_term_list']);
  $route_node = \Drupal::routeMatch()->getParameter('node');
  if ($route_node instanceof NodeInterface) {
    $cache_metadata->addCacheableDependency($route_node);
  }
  $cache_metadata->applyTo($block_build);
}

/**
 * Keeps Tags term labels in their hash-prefixed display format.
 */
function jurenites_blog_taxonomy_term_presave(TermInterface $tag_term): void {
  if ($tag_term->bundle() !== 'tags') {
    return;
  }

  $prefix_free_name = preg_replace(
    '/^#+\s*/u',
    '',
    trim($tag_term->label()),
  ) ?? '';
  if (in_array($prefix_free_name, ['Game', 'Game Dev'], TRUE)) {
    $prefix_free_name = 'Game Dev';
  }

  $tag_term->setName('#' . $prefix_free_name);
}

/**
 * Groups automatically managed YouTube metadata in a collapsed section.
 */
function jurenites_blog_form_node_video_form_alter(
  array &$form,
  FormStateInterface $form_state,
): void {
  $form['youtube_metadata'] = [
    '#type' => 'details',
    '#title' => t('YouTube metadata'),
    '#description' => t('These fields are filled automatically from YouTube when the Video is saved.'),
    '#open' => FALSE,
    '#weight' => ($form['field_youtube_video']['#weight'] ?? 2) + 0.5,
  ];

  $managed_field_names = [
    'field_youtube_creator_name',
    'field_youtube_creator_url',
    'field_youtube_published_date',
    'field_youtube_channel_avatar',
    'field_youtube_coauthor_name',
    'field_youtube_coauthor_url',
    'field_youtube_coauthor_avatar',
  ];
  foreach ($managed_field_names as $managed_field_name) {
    if (isset($form[$managed_field_name])) {
      // Group presentation without changing the field's submitted value path.
      $form[$managed_field_name]['#group'] = 'youtube_metadata';
    }
  }

  if (isset($form['field_youtube_video']['widget'][0]['video_id'])) {
    // The video ID is informational markup; URL validation still derives it.
    $form['youtube_metadata']['video_identifier'] = $form['field_youtube_video']['widget'][0]['video_id'];
    $form['youtube_metadata']['video_identifier']['#weight'] = -1;
    unset($form['field_youtube_video']['widget'][0]['video_id']);
  }

  if (isset($form['field_youtube_channel_avatar'])
    && !\Drupal::currentUser()->hasPermission('administer nodes')) {
    $form['field_youtube_channel_avatar']['#access'] = FALSE;
  }
  if (isset($form['field_youtube_coauthor_avatar'])
    && !\Drupal::currentUser()->hasPermission('administer nodes')) {
    $form['field_youtube_coauthor_avatar']['#access'] = FALSE;
  }
}

/**
 * Applies the Video metadata section to the node edit route as well.
 */
function jurenites_blog_form_node_video_edit_form_alter(
  array &$form,
  FormStateInterface $form_state,
): void {
  jurenites_blog_form_node_video_form_alter($form, $form_state);
}

/**
 * Hides automatically managed News metadata from non-administrators.
 */
function jurenites_blog_form_node_news_form_alter(
  array &$news_form,
  FormStateInterface $form_state,
): void {
  if (isset($news_form['field_news_source_url']['widget'][0]['uri'])) {
    $news_form['field_news_source_url']['widget'][0]['uri']['#description'] = t(
      'Source, publication time, and thumbnail are filled automatically when saved.',
    );
  }

  $news_node = $form_state->getFormObject()->getEntity();
  if (!$news_node->isNew()
    && \Drupal::currentUser()->hasPermission('administer nodes')) {
    return;
  }

  $managed_field_names = [
    'field_news_source_name',
    'field_news_source_published',
    'field_image',
  ];
  foreach ($managed_field_names as $managed_field_name) {
    if (isset($news_form[$managed_field_name])) {
      $news_form[$managed_field_name]['#access'] = FALSE;
    }
  }
}

/**
 * Populates managed metadata for Article and News content.
 */
function jurenites_blog_node_presave(NodeInterface $content_node): void {
  if ($content_node->bundle() === 'news') {
    jurenites_blog_set_news_metadata($content_node);
    return;
  }

  if (!in_array($content_node->bundle(), ['article', 'video'], TRUE)) {
    return;
  }

  $article_node = $content_node;

  $original_node = $article_node->getOriginal();
  $original_identifier = $original_node?->hasField('field_youtube_video')
    ? trim((string) $original_node->get('field_youtube_video')->video_id)
    : '';
  $has_youtube_video = ($article_node->bundle() === 'video'
      || !\Drupal::state()->get('jurenites_blog.video_content_type_split'))
    && $article_node->hasField('field_youtube_video')
    && !$article_node->get('field_youtube_video')->isEmpty();

  if (!$has_youtube_video) {
    if ($article_node->hasField('field_consumption_time_minutes')
      && ($article_node->get('field_consumption_time_minutes')->isEmpty()
        || $original_identifier !== '')) {
      $article_node->set('field_consumption_time_minutes', 5);
    }
    return;
  }

  $youtube_item = $article_node->get('field_youtube_video')->first();
  $video_url = trim((string) $youtube_item?->get('input')->getValue());
  $video_identifier = trim((string) $youtube_item?->get('video_id')->getValue());
  if ($video_url === '' || $video_identifier === '') {
    return;
  }

  if ($original_identifier !== $video_identifier) {
    foreach ([
      'field_consumption_time_minutes',
      'field_youtube_creator_name',
      'field_youtube_creator_url',
      'field_youtube_published_date',
    ] as $credit_field_name) {
      if ($article_node->hasField($credit_field_name)) {
        $article_node->set($credit_field_name, NULL);
      }
    }
  }

  if ($original_identifier !== '' && $original_identifier !== $video_identifier) {
    foreach (['field_youtube_coauthor_name', 'field_youtube_coauthor_url', 'field_youtube_coauthor_avatar'] as $credit_field_name) {
      if ($article_node->hasField($credit_field_name)) {
        $article_node->set($credit_field_name, NULL);
      }
    }
  }

  jurenites_blog_set_youtube_credit($article_node, $video_url);
  jurenites_blog_sync_authored_date($article_node);

  if ($article_node->hasField('field_image')
    && $article_node->get('field_image')->isEmpty()) {
    jurenites_blog_set_youtube_thumbnail($article_node, $video_url, $video_identifier);
  }
}

/**
 * Matches the Article authored calendar date to its YouTube publication date.
 */
function jurenites_blog_sync_authored_date(NodeInterface $article_node): void {
  if (!$article_node->hasField('field_youtube_published_date')
    || $article_node->get('field_youtube_published_date')->isEmpty()) {
    return;
  }

  $published_date_value = trim(
    (string) $article_node->get('field_youtube_published_date')->value,
  );
  $date_timezone_name = \Drupal::config('system.date')->get('timezone.default');
  $date_timezone = new \DateTimeZone(
    is_string($date_timezone_name) && $date_timezone_name !== ''
      ? $date_timezone_name
      : date_default_timezone_get(),
  );
  $published_date = \DateTimeImmutable::createFromFormat(
    '!Y-m-d',
    $published_date_value,
    $date_timezone,
  );
  if ($published_date === FALSE) {
    return;
  }

  $authored_timestamp = $article_node->getCreatedTime();
  if ($authored_timestamp <= 0) {
    $authored_timestamp = \Drupal::time()->getRequestTime();
  }
  $authored_date = (new \DateTimeImmutable('@' . $authored_timestamp))
    ->setTimezone($date_timezone)
    ->setDate(
      (int) $published_date->format('Y'),
      (int) $published_date->format('m'),
      (int) $published_date->format('d'),
    );

  $article_node->setCreatedTime($authored_date->getTimestamp());
}

/**
 * Populates empty creator, channel avatar, and source-publication fields.
 */
function jurenites_blog_set_youtube_credit(
  NodeInterface $article_node,
  string $video_url,
): void {
  $creator_name_missing = $article_node->hasField('field_youtube_creator_name')
    && $article_node->get('field_youtube_creator_name')->isEmpty();
  $creator_url_missing = $article_node->hasField('field_youtube_creator_url')
    && $article_node->get('field_youtube_creator_url')->isEmpty();
  $published_date_missing = $article_node->hasField('field_youtube_published_date')
    && $article_node->get('field_youtube_published_date')->isEmpty();
  $consumption_time_missing = $article_node->hasField('field_consumption_time_minutes')
    && $article_node->get('field_consumption_time_minutes')->isEmpty();
  $channel_avatar_missing = $article_node->hasField('field_youtube_channel_avatar')
    && trim((string) $article_node->get('field_youtube_channel_avatar')->value) === '';

  if ($creator_name_missing || $creator_url_missing) {
    try {
      $resource_url = \Drupal::service('media.oembed.url_resolver')->getResourceUrl($video_url);
      $video_resource = \Drupal::service('media.oembed.resource_fetcher')->fetchResource($resource_url);

      if ($creator_name_missing && trim((string) $video_resource->getAuthorName()) !== '') {
        $article_node->set('field_youtube_creator_name', $video_resource->getAuthorName());
      }
      $creator_url = $video_resource->getAuthorUrl()?->toString() ?? '';
      if ($creator_url_missing && $creator_url !== '') {
        $article_node->set('field_youtube_creator_url', ['uri' => $creator_url]);
      }
    }
    catch (\Throwable $creator_exception) {
      \Drupal::logger('jurenites_blog')->warning(
        'Unable to save the YouTube creator credit for content @article_id: @message',
        [
          '@article_id' => $article_node->id() ?? 'new',
          '@message' => $creator_exception->getMessage(),
        ],
      );
    }
  }

  $channel_cache_id = 'jurenites_blog:youtube_channels:' . hash('sha256', $video_url);
  $cached_channels = \Drupal::cache('data')->get($channel_cache_id);
  if ($cached_channels !== FALSE) {
    jurenites_blog_set_youtube_channel_credits($article_node, $cached_channels->data, FALSE);
  }
  $coauthor_name = $article_node->hasField('field_youtube_coauthor_name')
    ? trim((string) $article_node->get('field_youtube_coauthor_name')->value) : '';
  $coauthor_discovery_needed = $article_node->hasField('field_youtube_coauthor_name')
    && $coauthor_name === '' && $cached_channels === FALSE;
  $coauthor_credit_missing = $coauthor_name !== ''
    && ($article_node->get('field_youtube_coauthor_avatar')->isEmpty()
      || $article_node->get('field_youtube_coauthor_url')->isEmpty());
  if (!$published_date_missing && !$consumption_time_missing && !$channel_avatar_missing
    && !$coauthor_discovery_needed && !$coauthor_credit_missing) {
    return;
  }

  try {
    $date_separator = str_contains($video_url, '?') ? '&' : '?';
    $video_page_response = \Drupal::httpClient()->request(
      'GET',
      $video_url . $date_separator . 'hl=en',
      [
        'timeout' => 20,
        'headers' => [
          'Accept-Language' => 'en-US,en;q=0.9',
          'User-Agent' => 'Mozilla/5.0',
        ],
      ],
    );
    $video_page = (string) $video_page_response->getBody();
    $channel_credits = jurenites_blog_youtube_channel_credits($video_page);
    if ($channel_credits !== []) {
      \Drupal::cache('data')->set($channel_cache_id, $channel_credits, \Drupal::time()->getRequestTime() + 86400);
      jurenites_blog_set_youtube_channel_credits($article_node, $channel_credits);
    }
    if ($channel_avatar_missing) {
      if ($article_node->get('field_youtube_channel_avatar')->isEmpty()) {
        \Drupal::logger('jurenites_blog')->warning(
          'The YouTube page has no channel avatar for content @article_id.',
          ['@article_id' => $article_node->id() ?? 'new'],
        );
      }
    }
    if ($published_date_missing) {
      $date_found = preg_match('/"publishDate":"([^"]+)"/', $video_page, $date_matches);
      if ($date_found === 1) {
        $published_date_value = substr($date_matches[1], 0, 10);
        $article_node->set('field_youtube_published_date', $published_date_value);
      }
      else {
        \Drupal::logger('jurenites_blog')->warning(
          'The YouTube page has no publication timestamp for content @article_id.',
          ['@article_id' => $article_node->id() ?? 'new'],
        );
      }
    }

    if ($consumption_time_missing) {
      $duration_minutes = jurenites_blog_youtube_duration_minutes($video_page);
      if ($duration_minutes !== NULL) {
        $article_node->set('field_consumption_time_minutes', $duration_minutes);
      }
      else {
        \Drupal::logger('jurenites_blog')->warning(
          'The YouTube page has no video duration for content @article_id.',
          ['@article_id' => $article_node->id() ?? 'new'],
        );
      }
    }
  }
  catch (\Throwable $metadata_exception) {
    \Drupal::logger('jurenites_blog')->warning(
      'Unable to save YouTube page metadata for content @article_id: @message',
      [
        '@article_id' => $article_node->id() ?? 'new',
        '@message' => $metadata_exception->getMessage(),
      ],
    );
  }
}

/**
 * Fills missing channel fields without replacing editorial corrections.
 */
function jurenites_blog_set_youtube_channel_credits(NodeInterface $article_node, array $channel_credits, bool $include_primary_credit = TRUE): void {
  if ($channel_credits === []) {
    return;
  }
  $primary_channel_index = 0;
  $primary_channel_name = trim((string) $article_node->get('field_youtube_creator_name')->value);
  $primary_channel_url = trim((string) $article_node->get('field_youtube_creator_url')->uri);
  foreach ($channel_credits as $channel_index => $channel_credit) {
    if (($primary_channel_url !== '' && $channel_credit['channel_url'] === $primary_channel_url)
      || ($primary_channel_name !== '' && $channel_credit['channel_name'] === $primary_channel_name)) {
      $primary_channel_index = $channel_index;
      break;
    }
  }
  $primary_credit = $channel_credits[$primary_channel_index];
  if ($include_primary_credit && $article_node->hasField('field_youtube_channel_avatar')
    && trim((string) $article_node->get('field_youtube_channel_avatar')->value) === ''
    && $primary_credit['avatar_url'] !== '') {
    $article_node->set('field_youtube_channel_avatar', $primary_credit['avatar_url']);
  }
  if ($include_primary_credit) {
    foreach (['field_youtube_creator_name' => 'channel_name', 'field_youtube_creator_url' => 'channel_url'] as $field_name => $credit_property) {
      if ($article_node->get($field_name)->isEmpty() && $primary_credit[$credit_property] !== '') {
        $article_node->set($field_name, $credit_property === 'channel_url'
          ? ['uri' => $primary_credit[$credit_property]] : $primary_credit[$credit_property]);
      }
    }
  }
  if (!$article_node->hasField('field_youtube_coauthor_name')) {
    return;
  }
  $stored_coauthor_name = trim((string) $article_node->get('field_youtube_coauthor_name')->value);
  $stored_coauthor_url = trim((string) $article_node->get('field_youtube_coauthor_url')->uri);
  foreach ($channel_credits as $channel_index => $channel_credit) {
    if ($channel_index === $primary_channel_index
      || (($stored_coauthor_url !== '' || $stored_coauthor_name !== '')
        && $stored_coauthor_url !== $channel_credit['channel_url']
        && $stored_coauthor_name !== $channel_credit['channel_name'])) {
      continue;
    }
    foreach ([
      'field_youtube_coauthor_name' => 'channel_name',
      'field_youtube_coauthor_url' => 'channel_url',
      'field_youtube_coauthor_avatar' => 'avatar_url',
    ] as $field_name => $credit_property) {
      if ($article_node->get($field_name)->isEmpty() && $channel_credit[$credit_property] !== '') {
        $article_node->set($field_name, $credit_property === 'channel_url'
          ? ['uri' => $channel_credit[$credit_property]] : $channel_credit[$credit_property]);
      }
    }
    break;
  }
}

/**
 * Extracts credited channels, excluding comments and recommendations.
 */
function jurenites_blog_youtube_channel_credits(string $video_page): array {
  if (trim($video_page) === '') {
    return [];
  }
  $page_document = new \DOMDocument();
  @$page_document->loadHTML($video_page, LIBXML_NONET);
  foreach ($page_document->getElementsByTagName('script') as $script_element) {
    $script_content = $script_element->textContent;
    if (preg_match(
      '/(?:\bytInitialData|window\["ytInitialData"\])\s*=\s*(\{)/',
      $script_content,
      $initial_data_matches,
      PREG_OFFSET_CAPTURE,
    ) !== 1) {
      continue;
    }
    $initial_data = json_decode(rtrim(
      substr($script_content, $initial_data_matches[1][1]),
      " \t\n\r\0\x0B;",
    ), TRUE);
    // Limit lookup to the current video, outside the recommendations sidebar.
    $pending_sections = $initial_data['contents']['twoColumnWatchNextResults']['results']['results']['contents'] ?? [];
    while ($pending_sections !== []) {
      $current_section = array_pop($pending_sections);
      if (!is_array($current_section)) {
        continue;
      }
      if (isset($current_section['videoOwnerRenderer'])) {
        return jurenites_blog_youtube_owner_credits($current_section['videoOwnerRenderer']);
      }
      foreach ($current_section as $nested_section) {
        if (is_array($nested_section)) {
          $pending_sections[] = $nested_section;
        }
      }
    }
  }
  return [];
}

/**
 * Reads only the current owner's embedded collaborator list or single credit.
 */
function jurenites_blog_youtube_owner_credits(array $owner_data): array {
  $collaborator_items = $owner_data['navigationEndpoint']['showDialogCommand']['panelLoadingStrategy']['inlineContent']['dialogViewModel']['customContent']['listViewModel']['listItems'] ?? [];
  $channel_credits = [];
  foreach ($collaborator_items as $collaborator_item) {
    $channel_item = $collaborator_item['listItemViewModel'] ?? [];
    $channel_name = trim((string) ($channel_item['title']['content'] ?? ''));
    $channel_identifier = $channel_item['title']['commandRuns'][0]['onTap']['innertubeCommand']['browseEndpoint']['browseId']
      ?? $channel_item['rendererContext']['commandContext']['onTap']['innertubeCommand']['browseEndpoint']['browseId'] ?? '';
    if ($channel_name === '' || !is_string($channel_identifier)
      || preg_match('/^UC[A-Za-z0-9_-]{22}$/', $channel_identifier) !== 1) {
      continue;
    }
    $channel_credits[$channel_identifier] = [
      'channel_name' => $channel_name,
      'channel_url' => 'https://www.youtube.com/channel/' . $channel_identifier,
      'avatar_url' => jurenites_blog_youtube_avatar_from_images($channel_item['leadingAccessory']['avatarViewModel']['image']['sources'] ?? []),
    ];
  }
  if ($channel_credits !== []) {
    return array_values($channel_credits);
  }
  $avatar_url = jurenites_blog_youtube_avatar_from_images($owner_data['thumbnail']['thumbnails'] ?? []);
  $channel_name = $owner_data['title']['runs'][0]['text'] ?? $owner_data['title']['simpleText'] ?? '';
  if ($channel_name === '' && $avatar_url === '') {
    return [];
  }
  return [[
    'channel_name' => $channel_name,
    'channel_url' => '',
    'avatar_url' => $avatar_url,
  ]];
}

/**
 * Returns a supported channel image that fits the stored avatar URL field.
 */
function jurenites_blog_youtube_avatar_from_images(array $channel_images): string {
  foreach ($channel_images as $channel_image) {
    $avatar_url = $channel_image['url'] ?? '';
    if (!is_string($avatar_url) || strlen($avatar_url) > 255
      || filter_var($avatar_url, FILTER_VALIDATE_URL) === FALSE) {
      continue;
    }
    $avatar_parts = parse_url($avatar_url);
    if (($avatar_parts['scheme'] ?? '') === 'https'
      && !isset($avatar_parts['user']) && !isset($avatar_parts['pass'])
      && !isset($avatar_parts['port'])
      && in_array(strtolower($avatar_parts['host'] ?? ''), ['yt3.googleusercontent.com', 'yt3.ggpht.com'], TRUE)) {
      return $avatar_url;
    }
  }
  return '';
}

/**
 * Returns the first credited channel avatar for existing callers.
 */
function jurenites_blog_youtube_channel_avatar_url(string $video_page): string {
  return jurenites_blog_youtube_channel_credits($video_page)[0]['avatar_url'] ?? '';
}

/**
 * Converts YouTube page duration seconds to truncated whole minutes.
 */
function jurenites_blog_youtube_duration_minutes(string $video_page): ?int {
  $duration_found = preg_match('/"lengthSeconds":"(\d+)"/', $video_page, $duration_matches);
  if ($duration_found !== 1) {
    return NULL;
  }

  $duration_seconds = (int) $duration_matches[1];
  return max(1, intdiv($duration_seconds, 60));
}

/**
 * Populates managed metadata for a News source URL.
 */
function jurenites_blog_set_news_metadata(NodeInterface $news_node): void {
  if (!$news_node->hasField('field_news_source_url')
    || $news_node->get('field_news_source_url')->isEmpty()) {
    return;
  }

  $source_url = trim((string) $news_node->get('field_news_source_url')->uri);
  if ($source_url === '') {
    return;
  }

  $original_node = $news_node->getOriginal();
  $original_url = $original_node?->hasField('field_news_source_url')
    ? trim((string) $original_node->get('field_news_source_url')->uri)
    : '';
  $source_changed = $original_url !== '' && $source_url !== $original_url;
  $source_name_missing = $news_node->get('field_news_source_name')->isEmpty();
  $published_time_missing = $news_node->get('field_news_source_published')->isEmpty();
  $thumbnail_missing = $news_node->get('field_image')->isEmpty();

  if (!$source_changed
    && !$source_name_missing
    && !$published_time_missing
    && !$thumbnail_missing) {
    return;
  }

  $video_identifier = jurenites_blog_youtube_identifier($source_url);
  if ($video_identifier !== '') {
    jurenites_blog_set_news_youtube_metadata(
      $news_node,
      $source_url,
      $video_identifier,
      $source_changed,
    );
    return;
  }

  try {
    $page_metadata = [];
    try {
      $source_page = jurenites_blog_load_public_url($source_url, 5 * 1024 * 1024);
      $page_metadata = jurenites_blog_extract_page_metadata($source_page);
    }
    catch (\Throwable $page_exception) {
      $page_metadata = jurenites_blog_load_oembed_metadata($source_url);
    }

    if (in_array('', [
      (string) ($page_metadata['source_name'] ?? ''),
      (string) ($page_metadata['published_time'] ?? ''),
      (string) ($page_metadata['thumbnail_url'] ?? ''),
    ], TRUE)) {
      try {
        $oembed_metadata = jurenites_blog_load_oembed_metadata($source_url);
        foreach ($oembed_metadata as $metadata_name => $metadata_value) {
          if (($page_metadata[$metadata_name] ?? '') === '' && $metadata_value !== '') {
            $page_metadata[$metadata_name] = $metadata_value;
          }
        }
      }
      catch (\Throwable) {
        // Keep any metadata already found in the source page.
      }
    }
    $source_hostname = strtolower((string) parse_url($source_url, PHP_URL_HOST));
    $source_name = trim((string) ($page_metadata['source_name'] ?? ''));
    if ($source_name === '') {
      $source_name = preg_replace('/^www\./', '', $source_hostname) ?? '';
    }
    if (($source_changed || $source_name_missing) && $source_name !== '') {
      $news_node->set('field_news_source_name', $source_name);
    }

    $published_time = jurenites_blog_normalize_datetime(
      (string) ($page_metadata['published_time'] ?? ''),
    );
    if (($source_changed || $published_time_missing) && $published_time !== '') {
      $news_node->set('field_news_source_published', $published_time);
    }

    $thumbnail_url = jurenites_blog_resolve_source_url(
      $source_url,
      (string) ($page_metadata['thumbnail_url'] ?? ''),
    );
    if (($source_changed || $thumbnail_missing) && $thumbnail_url !== '') {
      jurenites_blog_set_news_thumbnail($news_node, $thumbnail_url);
    }
  }
  catch (\Throwable $metadata_exception) {
    \Drupal::logger('jurenites_blog')->warning(
      'Unable to save page metadata for News @news_id: @message',
      [
        '@news_id' => $news_node->id() ?? 'new',
        '@message' => $metadata_exception->getMessage(),
      ],
    );
  }
}

/**
 * Loads standard and provider-specific values from a known oEmbed endpoint.
 */
function jurenites_blog_load_oembed_metadata(string $source_url): array {
  $resource_url = \Drupal::service('media.oembed.url_resolver')->getResourceUrl($source_url);
  $resource_body = jurenites_blog_load_public_url($resource_url, 1024 * 1024);
  $resource_data = json_decode($resource_body, TRUE, flags: JSON_THROW_ON_ERROR);
  if (!is_array($resource_data)) {
    throw new \RuntimeException('The oEmbed response is not an object.');
  }

  return [
    'source_name' => trim((string) ($resource_data['provider_name'] ?? '')),
    'published_time' => trim((string) (
      $resource_data['publication_date']
      ?? $resource_data['date_published']
      ?? ''
    )),
    'thumbnail_url' => trim((string) ($resource_data['thumbnail_url'] ?? '')),
  ];
}

/**
 * Populates News metadata from the established YouTube workflow.
 */
function jurenites_blog_set_news_youtube_metadata(
  NodeInterface $news_node,
  string $video_url,
  string $video_identifier,
  bool $source_changed,
): void {
  $source_name_missing = $news_node->get('field_news_source_name')->isEmpty();
  $published_time_missing = $news_node->get('field_news_source_published')->isEmpty();
  $thumbnail_missing = $news_node->get('field_image')->isEmpty();

  if ($source_changed || $source_name_missing) {
    try {
      $resource_url = \Drupal::service('media.oembed.url_resolver')->getResourceUrl($video_url);
      $video_resource = \Drupal::service('media.oembed.resource_fetcher')->fetchResource($resource_url);
      $source_name = trim((string) $video_resource->getAuthorName());
      if ($source_name !== '') {
        $news_node->set('field_news_source_name', $source_name);
      }
    }
    catch (\Throwable $source_exception) {
      \Drupal::logger('jurenites_blog')->warning(
        'Unable to save the YouTube source for News @news_id: @message',
        [
          '@news_id' => $news_node->id() ?? 'new',
          '@message' => $source_exception->getMessage(),
        ],
      );
    }
  }

  if ($source_changed || $published_time_missing) {
    try {
      $date_separator = str_contains($video_url, '?') ? '&' : '?';
      $video_page = jurenites_blog_load_public_url(
        $video_url . $date_separator . 'hl=en',
        5 * 1024 * 1024,
      );
      $date_found = preg_match('/"publishDate":"([^"]+)"/', $video_page, $date_matches);
      $published_time = $date_found === 1
        ? jurenites_blog_normalize_datetime($date_matches[1])
        : '';
      if ($published_time !== '') {
        $news_node->set('field_news_source_published', $published_time);
      }
    }
    catch (\Throwable $date_exception) {
      \Drupal::logger('jurenites_blog')->warning(
        'Unable to save the YouTube publication time for News @news_id: @message',
        [
          '@news_id' => $news_node->id() ?? 'new',
          '@message' => $date_exception->getMessage(),
        ],
      );
    }
  }

  if ($source_changed || $thumbnail_missing) {
    jurenites_blog_set_youtube_thumbnail($news_node, $video_url, $video_identifier);
  }
}

/**
 * Extracts a YouTube video identifier from supported URL shapes.
 */
function jurenites_blog_youtube_identifier(string $video_url): string {
  $url_parts = parse_url($video_url);
  if (!is_array($url_parts)) {
    return '';
  }

  $video_host = strtolower((string) ($url_parts['host'] ?? ''));
  $video_path = trim((string) ($url_parts['path'] ?? ''), '/');
  if ($video_host === 'youtu.be' || $video_host === 'www.youtu.be') {
    return explode('/', $video_path)[0] ?? '';
  }
  if (!in_array($video_host, [
    'youtube.com',
    'www.youtube.com',
    'm.youtube.com',
    'youtube-nocookie.com',
    'www.youtube-nocookie.com',
  ], TRUE)) {
    return '';
  }

  parse_str((string) ($url_parts['query'] ?? ''), $query_parameters);
  if (isset($query_parameters['v']) && is_string($query_parameters['v'])) {
    return trim($query_parameters['v']);
  }
  if (preg_match('#^(?:shorts|embed|live)/([^/]+)#', $video_path, $path_matches) === 1) {
    return trim($path_matches[1]);
  }

  return '';
}

/**
 * Loads a bounded public HTTP(S) resource and validates redirects.
 */
function jurenites_blog_load_public_url(string $remote_url, int $byte_limit): string {
  if (!jurenites_blog_is_public_url($remote_url)) {
    throw new \InvalidArgumentException('Only public HTTP(S) source URLs can be loaded.');
  }

  $remote_response = \Drupal::httpClient()->request('GET', $remote_url, [
    'timeout' => 20,
    'headers' => [
      'Accept-Language' => 'en-US,en;q=0.9',
      'User-Agent' => 'Mozilla/5.0 (compatible; JurenitesNews/1.0)',
    ],
    'allow_redirects' => [
      'max' => 3,
      'strict' => TRUE,
      'referer' => FALSE,
      'on_redirect' => static function (
        $redirect_request,
        $redirect_response,
        $redirect_uri,
      ): void {
        if (!jurenites_blog_is_public_url((string) $redirect_uri)) {
          throw new \RuntimeException('A source redirected to a non-public URL.');
        }
      },
    ],
  ]);
  $remote_body = (string) $remote_response->getBody();
  if (strlen($remote_body) > $byte_limit) {
    throw new \RuntimeException('The remote resource exceeds the supported size.');
  }

  return $remote_body;
}

/**
 * Reports whether a URL resolves only to public network addresses.
 */
function jurenites_blog_is_public_url(string $remote_url): bool {
  $url_parts = parse_url($remote_url);
  if (!is_array($url_parts)) {
    return FALSE;
  }

  $url_scheme = strtolower((string) ($url_parts['scheme'] ?? ''));
  $url_host = strtolower((string) ($url_parts['host'] ?? ''));
  if (!in_array($url_scheme, ['http', 'https'], TRUE)
    || $url_host === ''
    || $url_host === 'localhost'
    || str_ends_with($url_host, '.local')
    || str_ends_with($url_host, '.internal')) {
    return FALSE;
  }

  if (filter_var($url_host, FILTER_VALIDATE_IP) !== FALSE) {
    return filter_var(
      $url_host,
      FILTER_VALIDATE_IP,
      FILTER_FLAG_NO_PRIV_RANGE | FILTER_FLAG_NO_RES_RANGE,
    ) !== FALSE;
  }

  $address_records = dns_get_record($url_host, DNS_A | DNS_AAAA);
  if (!is_array($address_records) || $address_records === []) {
    return FALSE;
  }
  foreach ($address_records as $address_record) {
    $resolved_address = $address_record['ip'] ?? $address_record['ipv6'] ?? '';
    if ($resolved_address !== '' && filter_var(
      $resolved_address,
      FILTER_VALIDATE_IP,
      FILTER_FLAG_NO_PRIV_RANGE | FILTER_FLAG_NO_RES_RANGE,
    ) === FALSE) {
      return FALSE;
    }
  }

  return TRUE;
}

/**
 * Extracts supported Open Graph, article, and JSON-LD values.
 */
function jurenites_blog_extract_page_metadata(string $source_page): array {
  $page_document = new \DOMDocument();
  $previous_errors = libxml_use_internal_errors(TRUE);
  $page_loaded = $page_document->loadHTML($source_page);
  libxml_clear_errors();
  libxml_use_internal_errors($previous_errors);
  if (!$page_loaded) {
    throw new \RuntimeException('The source page HTML could not be read.');
  }

  $meta_values = [];
  foreach ($page_document->getElementsByTagName('meta') as $meta_element) {
    $meta_name = strtolower(trim(
      $meta_element->getAttribute('property') ?: $meta_element->getAttribute('name'),
    ));
    $meta_content = trim(html_entity_decode(
      $meta_element->getAttribute('content'),
      ENT_QUOTES | ENT_HTML5,
    ));
    if ($meta_name !== '' && $meta_content !== '' && !isset($meta_values[$meta_name])) {
      $meta_values[$meta_name] = $meta_content;
    }
  }

  $structured_values = [];
  foreach ($page_document->getElementsByTagName('script') as $script_element) {
    if (strtolower(trim($script_element->getAttribute('type'))) !== 'application/ld+json') {
      continue;
    }
    $structured_data = json_decode(trim($script_element->textContent), TRUE);
    if (is_array($structured_data)) {
      $structured_values[] = $structured_data;
    }
  }

  $publisher_value = jurenites_blog_find_structured_value($structured_values, 'publisher');
  $source_name = $meta_values['og:site_name']
    ?? $meta_values['application-name']
    ?? jurenites_blog_structured_string($publisher_value, 'name');
  $published_time = $meta_values['article:published_time']
    ?? $meta_values['datepublished']
    ?? $meta_values['date']
    ?? jurenites_blog_structured_string(
      jurenites_blog_find_structured_value($structured_values, 'datePublished'),
    );
  $thumbnail_url = $meta_values['og:image:secure_url']
    ?? $meta_values['og:image']
    ?? $meta_values['twitter:image']
    ?? jurenites_blog_structured_string(
      jurenites_blog_find_structured_value($structured_values, 'image'),
      'url',
    );

  return [
    'source_name' => $source_name,
    'published_time' => $published_time,
    'thumbnail_url' => $thumbnail_url,
  ];
}

/**
 * Finds the first named value in nested structured metadata.
 */
function jurenites_blog_find_structured_value(mixed $structured_data, string $value_name): mixed {
  if (!is_array($structured_data)) {
    return NULL;
  }
  if (array_key_exists($value_name, $structured_data)) {
    return $structured_data[$value_name];
  }
  foreach ($structured_data as $nested_value) {
    $found_value = jurenites_blog_find_structured_value($nested_value, $value_name);
    if ($found_value !== NULL) {
      return $found_value;
    }
  }

  return NULL;
}

/**
 * Converts a structured metadata value to a useful string.
 */
function jurenites_blog_structured_string(mixed $structured_value, string $value_key = ''): string {
  if (is_string($structured_value)) {
    return trim($structured_value);
  }
  if (!is_array($structured_value)) {
    return '';
  }
  if ($value_key !== '' && isset($structured_value[$value_key])) {
    return jurenites_blog_structured_string($structured_value[$value_key]);
  }
  foreach ($structured_value as $nested_value) {
    $nested_string = jurenites_blog_structured_string($nested_value, $value_key);
    if ($nested_string !== '') {
      return $nested_string;
    }
  }

  return '';
}

/**
 * Converts a source timestamp to Drupal's UTC storage format.
 */
function jurenites_blog_normalize_datetime(string $source_datetime): string {
  if (trim($source_datetime) === '') {
    return '';
  }
  try {
    return (new \DateTimeImmutable($source_datetime))
      ->setTimezone(new \DateTimeZone('UTC'))
      ->format('Y-m-d\TH:i:s');
  }
  catch (\Throwable) {
    return '';
  }
}

/**
 * Resolves a page metadata URL against its source page.
 */
function jurenites_blog_resolve_source_url(string $source_url, string $candidate_url): string {
  $candidate_url = trim(html_entity_decode($candidate_url, ENT_QUOTES | ENT_HTML5));
  if ($candidate_url === '') {
    return '';
  }
  try {
    return (string) \GuzzleHttp\Psr7\UriResolver::resolve(
      new \GuzzleHttp\Psr7\Uri($source_url),
      new \GuzzleHttp\Psr7\Uri($candidate_url),
    );
  }
  catch (\Throwable) {
    return '';
  }
}

/**
 * Downloads a page thumbnail into the News Image field.
 */
function jurenites_blog_set_news_thumbnail(
  NodeInterface $news_node,
  string $thumbnail_url,
): bool {
  try {
    $thumbnail_data = jurenites_blog_load_public_url($thumbnail_url, 15 * 1024 * 1024);
    $image_information = @getimagesizefromstring($thumbnail_data);
    $image_extensions = [
      IMAGETYPE_JPEG => 'jpg',
      IMAGETYPE_PNG => 'png',
      IMAGETYPE_WEBP => 'webp',
    ];
    $image_extension = $image_information !== FALSE
      ? ($image_extensions[$image_information[2]] ?? NULL)
      : NULL;
    if ($image_information === FALSE || $image_extension === NULL) {
      throw new \RuntimeException('The downloaded News thumbnail format is not supported.');
    }

    $thumbnail_directory = 'public://news-thumbnails';
    $directory_ready = \Drupal::service('file_system')->prepareDirectory(
      $thumbnail_directory,
      FileSystemInterface::CREATE_DIRECTORY | FileSystemInterface::MODIFY_PERMISSIONS,
    );
    if (!$directory_ready) {
      throw new \RuntimeException('The News thumbnail directory is not writable.');
    }

    $thumbnail_uri = sprintf(
      '%s/%s.%s',
      $thumbnail_directory,
      hash('sha256', $thumbnail_url),
      $image_extension,
    );
    $thumbnail_file = \Drupal::service('file.repository')->writeData(
      $thumbnail_data,
      $thumbnail_uri,
      FileExists::Replace,
    );
    $thumbnail_file->setPermanent();
    $thumbnail_file->save();
    $news_node->set('field_image', [
      'target_id' => $thumbnail_file->id(),
      'alt' => $news_node->label(),
      'width' => $image_information[0],
      'height' => $image_information[1],
    ]);

    return TRUE;
  }
  catch (\Throwable $thumbnail_exception) {
    \Drupal::logger('jurenites_blog')->warning(
      'Unable to save the page thumbnail for News @news_id: @message',
      [
        '@news_id' => $news_node->id() ?? 'new',
        '@message' => $thumbnail_exception->getMessage(),
      ],
    );

    return FALSE;
  }
}

/**
 * Downloads the best available YouTube thumbnail into a content Image field.
 */
function jurenites_blog_set_youtube_thumbnail(
  NodeInterface $content_node,
  string $video_url,
  string $video_identifier,
): bool {
  try {
    $resource_url = \Drupal::service('media.oembed.url_resolver')->getResourceUrl($video_url);
    $video_resource = \Drupal::service('media.oembed.resource_fetcher')->fetchResource($resource_url);
    $thumbnail_resource_url = $video_resource->getThumbnailUrl();
    $fallback_thumbnail_url = $thumbnail_resource_url?->toString() ?? '';
    if ($fallback_thumbnail_url === '') {
      throw new \RuntimeException('The video metadata has no thumbnail URL.');
    }

    $thumbnail_candidates = [
      [
        'thumbnail_url' => sprintf(
          'https://i.ytimg.com/vi/%s/maxresdefault.jpg',
          rawurlencode($video_identifier),
        ),
        'minimum_width' => 1000,
      ],
      [
        'thumbnail_url' => $fallback_thumbnail_url,
        'minimum_width' => 1,
      ],
    ];
    $thumbnail_data = '';
    $image_information = FALSE;
    foreach ($thumbnail_candidates as $thumbnail_candidate) {
      try {
        $thumbnail_response = \Drupal::httpClient()->request(
          'GET',
          $thumbnail_candidate['thumbnail_url'],
          ['timeout' => 10],
        );
        $candidate_data = (string) $thumbnail_response->getBody();
        $candidate_information = @getimagesizefromstring($candidate_data);
        if ($candidate_information !== FALSE
          && $candidate_information[0] >= $thumbnail_candidate['minimum_width']) {
          $thumbnail_data = $candidate_data;
          $image_information = $candidate_information;
          break;
        }
      }
      catch (\Throwable) {
        // Continue to the lower-resolution oEmbed fallback.
      }
    }
    if ($image_information === FALSE) {
      throw new \RuntimeException('No supported YouTube thumbnail could be downloaded.');
    }

    $image_extensions = [
      IMAGETYPE_JPEG => 'jpg',
      IMAGETYPE_PNG => 'png',
      IMAGETYPE_WEBP => 'webp',
    ];
    $image_extension = $image_extensions[$image_information[2]] ?? NULL;
    if ($image_extension === NULL) {
      throw new \RuntimeException('The downloaded thumbnail format is not supported.');
    }

    $thumbnail_directory = 'public://youtube-thumbnails';
    $directory_ready = \Drupal::service('file_system')->prepareDirectory(
      $thumbnail_directory,
      FileSystemInterface::CREATE_DIRECTORY | FileSystemInterface::MODIFY_PERMISSIONS,
    );
    if (!$directory_ready) {
      throw new \RuntimeException('The YouTube thumbnail directory is not writable.');
    }

    $safe_identifier = preg_replace('/[^A-Za-z0-9_-]+/', '-', $video_identifier);
    $thumbnail_uri = sprintf(
      '%s/%s.%s',
      $thumbnail_directory,
      trim((string) $safe_identifier, '-'),
      $image_extension,
    );
    $thumbnail_file = \Drupal::service('file.repository')->writeData(
      $thumbnail_data,
      $thumbnail_uri,
      FileExists::Replace,
    );
    $thumbnail_file->setPermanent();
    $thumbnail_file->save();

    $thumbnail_alt = trim((string) $video_resource->getTitle());
    $content_node->set('field_image', [
      'target_id' => $thumbnail_file->id(),
      'alt' => $thumbnail_alt !== '' ? $thumbnail_alt : $content_node->label(),
      'width' => $image_information[0],
      'height' => $image_information[1],
    ]);

    return TRUE;
  }
  catch (\Throwable $thumbnail_exception) {
    \Drupal::logger('jurenites_blog')->warning(
      'Unable to save the YouTube thumbnail for content @content_id: @message',
      [
        '@content_id' => $content_node->id() ?? 'new',
        '@message' => $thumbnail_exception->getMessage(),
      ],
    );

    return FALSE;
  }
}
