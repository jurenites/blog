<?php

declare(strict_types=1);

/**
 * @file
 * Presentation data for the Jurenites Timeline page.
 */

use Drupal\Core\Cache\Cache;
use Drupal\Core\Datetime\DrupalDateTime;
use Drupal\Component\Utility\Unicode;
use Drupal\node\NodeInterface;
use Drupal\paragraphs\ParagraphInterface;

const JURENITES_TIMELINE_MAXIMUM_LANES = 4;
const JURENITES_TIMELINE_FIRST_YEAR = 2010;
const JURENITES_TIMELINE_FIRST_MONTH = 8;

/**
 * Implements hook_preprocess_node().
 */
function jurenites_timeline_preprocess_node(array &$node_variables): void {
  $timeline_node = $node_variables['node'] ?? NULL;
  if (!$timeline_node instanceof NodeInterface || $timeline_node->bundle() !== 'timeline') {
    return;
  }

  $timeline_items = [];
  foreach ($timeline_node->get('field_timeline_items')->referencedEntities() as $item_delta => $timeline_paragraph) {
    if (!$timeline_paragraph instanceof ParagraphInterface
      || $timeline_paragraph->bundle() !== 'timeline_item') {
      continue;
    }

    $timeline_paragraph = \Drupal::service('entity.repository')->getTranslationFromContext($timeline_paragraph);
    if ((string) $timeline_paragraph->get('field_timeline_kind')->value !== 'project') {
      continue;
    }
    $timeline_item = jurenites_timeline_build_item($timeline_paragraph);
    $timeline_item['editorial_order'] = $item_delta;
    $timeline_items[] = $timeline_item;
  }

  $timeline_items = array_values(array_filter(
    $timeline_items,
    static function (array $timeline_item): bool {
      foreach ($timeline_item['periods'] as $timeline_period) {
        if ($timeline_period['end_year'] >= JURENITES_TIMELINE_FIRST_YEAR) {
          return TRUE;
        }
      }
      return FALSE;
    },
  ));

  usort(
    $timeline_items,
    static fn (array $first_item, array $second_item): int =>
      strcmp($second_item['sort_date'], $first_item['sort_date'])
      ?: $first_item['editorial_order'] <=> $second_item['editorial_order'],
  );

  $current_organization_name = '';
  $initial_organization_heading = NULL;
  foreach ($timeline_items as &$timeline_item) {
    $organization_name = $timeline_item['organization_name'];
    $timeline_item['organization_heading'] = NULL;
    if ($organization_name !== '' && $organization_name !== $current_organization_name) {
      $timeline_item['organization_heading'] = [
        'name' => $organization_name,
        'url' => $timeline_item['organization_url'],
      ];
      $initial_organization_heading ??= $timeline_item['organization_heading'];
      $current_organization_name = $organization_name;
    }
  }
  unset($timeline_item);

  $current_date = DrupalDateTime::createFromTimestamp(\Drupal::time()->getRequestTime());
  $site_timezone = (string) (\Drupal::config('system.date')->get('timezone.default') ?: date_default_timezone_get());
  $current_date->setTimezone(new \DateTimeZone($site_timezone));
  $next_month_date = clone $current_date;
  $next_month_date->modify('first day of next month midnight');
  $seconds_until_next_month = max(1, $next_month_date->getTimestamp() - $current_date->getTimestamp());
  $existing_max_age = $node_variables['elements']['#cache']['max-age'] ?? Cache::PERMANENT;
  $node_variables['elements']['#cache']['max-age'] = Cache::mergeMaxAges(
    $existing_max_age,
    $seconds_until_next_month,
  );
  $lane_assignments = jurenites_timeline_assign_lanes($timeline_items);
  $timeline_year_groups = jurenites_timeline_build_year_groups(
    $timeline_items,
    $lane_assignments,
    (int) $current_date->format('Y'),
    (int) $current_date->format('n'),
  );

  $theme_path = \Drupal::service('extension.list.theme')->getPath('jurenites_theme');
  $node_variables['timeline_year_groups'] = $timeline_year_groups;
  $node_variables['timeline_initial_organization'] = $initial_organization_heading;
  $node_variables['timeline_item_count'] = count($timeline_items);
  $node_variables['icon_asset_base_url'] = base_path() . $theme_path . '/assets/icons';
}

/**
 * Builds one safe, sortable Timeline item presentation record.
 */
function jurenites_timeline_build_item(ParagraphInterface $timeline_paragraph): array {
  $timeline_periods = [];
  $primary_start_date = '';

  foreach ($timeline_paragraph->get('field_timeline_periods')->getValue() as $period_delta => $timeline_period_value) {
    $period_start_value = (string) ($timeline_period_value['value'] ?? '');
    $period_end_value = (string) ($timeline_period_value['end_value'] ?? $period_start_value);
    if ($period_start_value === '') {
      continue;
    }
    if ($period_delta === 0) {
      $primary_start_date = $period_start_value;
    }

    $period_start_date = new DrupalDateTime($period_start_value, 'UTC');
    $period_end_date = new DrupalDateTime($period_end_value, 'UTC');
    $date_format_pattern = 'M Y';
    $timeline_periods[] = [
      'start_iso' => $period_start_date->format('Y-m-d'),
      'end_iso' => $period_end_date->format('Y-m-d'),
      'start_label' => Unicode::ucfirst($period_start_date->format($date_format_pattern)),
      'end_label' => Unicode::ucfirst($period_end_date->format($date_format_pattern)),
      'start_year' => (int) $period_start_date->format('Y'),
      'end_year' => (int) $period_end_date->format('Y'),
      'start_month' => (int) $period_start_date->format('n'),
      'end_month' => (int) $period_end_date->format('n'),
      'start_month_number' => ((int) $period_start_date->format('Y') * 12) + (int) $period_start_date->format('n'),
      'end_month_number' => ((int) $period_end_date->format('Y') * 12) + (int) $period_end_date->format('n'),
      'is_range' => $period_start_date->format($date_format_pattern) !== $period_end_date->format($date_format_pattern),
    ];
  }

  $timeline_hours = $timeline_paragraph->get('field_timeline_hours')->value;
  $timeline_summary = $timeline_paragraph->get('field_timeline_summary')->isEmpty()
    ? NULL
    : $timeline_paragraph->get('field_timeline_summary')->processed;
  $organization_url = '';
  if ($timeline_paragraph->hasField('field_timeline_organization_url')
    && !$timeline_paragraph->get('field_timeline_organization_url')->isEmpty()) {
    $organization_url = $timeline_paragraph->get('field_timeline_organization_url')->first()->getUrl()->toString();
  }

  $proof_links = [];
  if ($timeline_paragraph->hasField('field_timeline_proof_links')) {
    foreach ($timeline_paragraph->get('field_timeline_proof_links') as $proof_delta => $proof_item) {
      if ($proof_item->isEmpty()) {
        continue;
      }
      $proof_links[] = [
        'url' => $proof_item->getUrl()->toString(),
        'label' => (string) ($proof_item->title ?: t('Proof @number', ['@number' => $proof_delta + 1])),
      ];
    }
  }

  return [
    'item_name' => (string) $timeline_paragraph->getUntranslated()->get('field_timeline_name')->value,
    'item_kind' => 'project',
    'organization_name' => (string) $timeline_paragraph->getUntranslated()->get('field_timeline_organization')->value,
    'organization_url' => $organization_url,
    'periods' => $timeline_periods,
    'hours_label' => $timeline_hours === NULL ? '' : (string) t('@hours h', ['@hours' => number_format((int) $timeline_hours)]),
    'summary_markup' => $timeline_summary,
    'proof_links' => $proof_links,
    'primary_project_url' => $proof_links !== []
      ? $proof_links[0]['url']
      : '',
    'emphasis_kind' => (string) ($timeline_paragraph->get('field_timeline_emphasis')->value ?: 'standard'),
    'sort_date' => $primary_start_date ?: '0000-01-01',
  ];
}

/**
 * Assigns each dated period to the first open parallel lane.
 */
function jurenites_timeline_assign_lanes(array $timeline_items): array {
  $dated_periods = [];
  foreach ($timeline_items as $item_index => $timeline_item) {
    foreach ($timeline_item['periods'] as $period_index => $timeline_period) {
      $dated_periods[] = [
        'item_index' => $item_index,
        'period_index' => $period_index,
        'start_month_number' => $timeline_period['start_month_number'],
        'end_month_number' => $timeline_period['end_month_number'],
      ];
    }
  }
  usort(
    $dated_periods,
    static fn (array $first_period, array $second_period): int =>
      $first_period['start_month_number'] <=> $second_period['start_month_number']
      ?: $second_period['end_month_number'] <=> $first_period['end_month_number'],
  );

  $lane_end_months = array_fill(0, JURENITES_TIMELINE_MAXIMUM_LANES, PHP_INT_MIN);
  $lane_assignments = [];
  foreach ($dated_periods as $dated_period) {
    $available_lane_index = NULL;
    foreach ($lane_end_months as $lane_index => $lane_end_month) {
      if ($lane_end_month < $dated_period['start_month_number']) {
        $available_lane_index = $lane_index;
        break;
      }
    }

    $is_overflow_overlap = FALSE;
    if ($available_lane_index === NULL) {
      $available_lane_index = array_search(min($lane_end_months), $lane_end_months, TRUE);
      $is_overflow_overlap = TRUE;
    }
    $lane_end_months[$available_lane_index] = max(
      $lane_end_months[$available_lane_index],
      $dated_period['end_month_number'],
    );
    $assignment_key = $dated_period['item_index'] . ':' . $dated_period['period_index'];
    $lane_assignments[$assignment_key] = [
      'lane_number' => $available_lane_index + 1,
      'is_overflow_overlap' => $is_overflow_overlap,
    ];
  }

  return $lane_assignments;
}

/**
 * Splits ranges into equal-height calendar-year fragments for presentation.
 */
function jurenites_timeline_build_year_groups(
  array $timeline_items,
  array $lane_assignments,
  int $current_year,
  int $current_month,
): array {
  $year_fragments = [];
  $maximum_year = 0;
  $minimum_year = PHP_INT_MAX;
  $current_month_number = ($current_year * 12) + $current_month;

  foreach ($timeline_items as $item_index => $timeline_item) {
    foreach ($timeline_item['periods'] as $period_index => $timeline_period) {
      if ($timeline_period['start_month_number'] > $current_month_number) {
        continue;
      }
      $visible_end_year = min($timeline_period['end_year'], $current_year);
      $maximum_year = max($maximum_year, $visible_end_year);
      $minimum_year = min(
        $minimum_year,
        max($timeline_period['start_year'], JURENITES_TIMELINE_FIRST_YEAR),
      );
      $assignment_key = $item_index . ':' . $period_index;
      $lane_assignment = $lane_assignments[$assignment_key];

      $visible_start_year = max($timeline_period['start_year'], JURENITES_TIMELINE_FIRST_YEAR);
      for ($fragment_year = $visible_end_year; $fragment_year >= $visible_start_year; $fragment_year--) {
        $fragment_start_month = $fragment_year === $timeline_period['start_year']
          ? $timeline_period['start_month']
          : 1;
        $fragment_end_month = $fragment_year === $timeline_period['end_year']
          ? $timeline_period['end_month']
          : 12;
        if ($fragment_year === $current_year) {
          $fragment_end_month = min($fragment_end_month, $current_month);
        }
        if ($fragment_year === JURENITES_TIMELINE_FIRST_YEAR) {
          $fragment_start_month = max($fragment_start_month, JURENITES_TIMELINE_FIRST_MONTH);
        }
        if ($fragment_start_month > $fragment_end_month) {
          continue;
        }
        $show_details = $fragment_year === $timeline_period['start_year'];
        $visible_month_count = $fragment_year === $current_year ? $current_month : 12;
        $year_fragments[$fragment_year][] = [
          'project_key' => 'project-' . $item_index,
          'period_key' => 'project-' . $item_index . '-period-' . $period_index,
          'start_month' => $timeline_period['start_month'],
          'continues_before' => $fragment_year > $timeline_period['start_year'],
          'continues_after' => $fragment_year < $visible_end_year,
          'item_name' => $timeline_item['item_name'],
          'item_kind' => $timeline_item['item_kind'],
          'hours_label' => $timeline_item['hours_label'],
          'summary_markup' => $period_index === 0 ? $timeline_item['summary_markup'] : NULL,
          'proof_links' => $period_index === 0 ? array_slice($timeline_item['proof_links'], 1) : [],
          'primary_project_url' => $timeline_item['primary_project_url'],
          'emphasis_kind' => $timeline_item['emphasis_kind'],
          'organization_heading' => $period_index === 0 ? $timeline_item['organization_heading'] : NULL,
          'period' => $timeline_period,
          'show_details' => $show_details,
          'lane_number' => $lane_assignment['lane_number'],
          'is_overflow_overlap' => $lane_assignment['is_overflow_overlap'],
          'ending_month' => $fragment_end_month,
          'row_start' => $visible_month_count - $fragment_end_month + 1,
          'month_span' => $fragment_end_month - $fragment_start_month + 1,
          'sort_date' => $show_details ? $timeline_period['start_iso'] : sprintf('%04d-12-31', $fragment_year),
        ];
      }
    }
  }

  if ($maximum_year === 0 || $minimum_year === PHP_INT_MAX) {
    return [];
  }

  $month_names = [
    12 => (string) t('Dec'),
    11 => (string) t('Nov'),
    10 => (string) t('Oct'),
    9 => (string) t('Sep'),
    8 => (string) t('Aug'),
    7 => (string) t('Jul'),
    6 => (string) t('Jun'),
    5 => (string) t('May'),
    4 => (string) t('Apr'),
    3 => (string) t('Mar'),
    2 => (string) t('Feb'),
    1 => (string) t('Jan'),
  ];
  $timeline_year_groups = [];
  for ($year_number = $maximum_year; $year_number >= $minimum_year; $year_number--) {
    $timeline_fragments = $year_fragments[$year_number] ?? [];
    usort(
      $timeline_fragments,
      static fn (array $first_fragment, array $second_fragment): int =>
        strcmp($second_fragment['sort_date'], $first_fragment['sort_date'])
        ?: $first_fragment['lane_number'] <=> $second_fragment['lane_number'],
    );
    $timeline_months = [];
    foreach ($month_names as $month_number => $month_name) {
      if ($year_number === $current_year && $month_number > $current_month) {
        continue;
      }
      if ($year_number === JURENITES_TIMELINE_FIRST_YEAR && $month_number < JURENITES_TIMELINE_FIRST_MONTH) {
        continue;
      }
      $timeline_months[] = [
        'label' => Unicode::ucfirst($month_name),
        'datetime' => sprintf('%04d-%02d', $year_number, $month_number),
      ];
    }
    $timeline_year_groups[] = [
      'year_label' => (string) $year_number,
      'visible_month_count' => count($timeline_months),
      'timeline_months' => $timeline_months,
      'timeline_fragments' => $timeline_fragments,
      'timeline_details' => array_values(array_filter(
        $timeline_fragments,
        static fn (array $timeline_fragment): bool => $timeline_fragment['show_details'],
      )),
    ];
  }

  return $timeline_year_groups;
}
