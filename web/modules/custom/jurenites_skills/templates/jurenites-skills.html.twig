{% if skill_items %}
  <section class="skills-profile" aria-label="{{ 'Web development skills'|t }}">
    <header class="skills-profile__header">
      <p class="skills-profile__eyebrow">{{ 'Web development'|t }}</p>
      <h2 class="skills-profile__heading">{{ section_heading }}</h2>
      <p class="skills-profile__intro">{{ section_description }}</p>
      <p class="skills-profile__rating-note">{{ ratings_reviewed ? 'Self-assessed confidence / 5'|t : 'Draft confidence / 5 · provisional estimates, pending my review'|t }}</p>
    </header>
    <ul class="skills-profile__grid">
      {% for skill_item in skill_items %}
        <li class="skills-profile__item">
          <div class="skills-profile__item-heading">
            <div class="skills-profile__identity">
              <p class="skills-profile__category">{{ skill_item.skill_category }}</p>
              <h3 class="skills-profile__technology">{{ skill_item.technology_name }}</h3>
            </div>
            {% if skill_item.skill_score is not null %}
              <p class="skills-profile__score" aria-label="{{ '@technology: @score out of 5'|t({'@technology': skill_item.technology_name, '@score': skill_item.skill_score}) }}">{{ skill_item.skill_score }}<span class="skills-profile__score-total" aria-hidden="true"> / 5</span></p>
            {% else %}
              <p class="skills-profile__unrated">{{ 'Not assessed'|t }}</p>
            {% endif %}
          </div>
          <p class="skills-profile__description">{{ skill_item.skill_description }}</p>
          <p class="skills-profile__evidence">{{ skill_item.experience_note }}</p>
        </li>
      {% endfor %}
    </ul>
    <footer class="skills-profile__footer">
      <p class="skills-profile__supporting-note">{{ supporting_note }}</p>
      <details class="skills-profile__scale">
        <summary class="skills-profile__scale-toggle">{{ 'How to read the levels'|t }}</summary>
        <p class="skills-profile__scale-description">{{ '1.0 Basic awareness · 2.0 Work with guidance · 3.0 Independent routine work · 4.0 Solve complex problems · 5.0 Deep expertise. Decimals express a subjective estimate, not a test result. Project experience and current confidence are different things.'|t }}</p>
      </details>
      <a class="skills-profile__timeline-link" href="{{ timeline_url }}">{{ 'Explore my project history'|t }} <span aria-hidden="true">↗</span></a>
    </footer>
  </section>
{% endif %}
