<?php

/**
 * @file
 * Adds project-specific loading states to blurry image placeholders.
 */

use Drupal\Core\Entity\EntityInterface;
use Drupal\file\FileInterface;

/**
 * Implements hook_entity_insert().
 */
function jurenites_progressive_images_entity_insert(EntityInterface $inserted_entity): void {
  if (!$inserted_entity instanceof FileInterface) {
    return;
  }

  $file_mime_type = $inserted_entity->getMimeType() ?? '';
  if (!str_starts_with($file_mime_type, 'image/')) {
    return;
  }

  // Generate and cache the embedded 20px preview during upload instead of on
  // the visitor's first request.
  \Drupal::service('image_blurry_placeholder.manager')
    ->getPlaceholderImage($inserted_entity->getFileUri());
}

/**
 * Implements template_preprocess_image().
 */
function jurenites_progressive_images_preprocess_image(array &$image_variables): void {
  $image_classes = $image_variables['attributes']['class'] ?? [];
  if (!in_array('img-blurry-placeholder', $image_classes, TRUE)) {
    return;
  }

  $inline_styles = (array) ($image_variables['attributes']['style'] ?? []);
  $remaining_styles = [];
  foreach ($inline_styles as $inline_style) {
    if (preg_match('/^background-image:\s*url\((.*)\);?$/', $inline_style, $preview_match) === 1) {
      $image_variables['attributes']['data-progressive-image-preview'] = trim(
        $preview_match[1],
        " \t\n\r\0\x0B\"'"
      );
      continue;
    }
    $remaining_styles[] = $inline_style;
  }

  if ($remaining_styles === []) {
    unset($image_variables['attributes']['style']);
  }
  else {
    $image_variables['attributes']['style'] = $remaining_styles;
  }

  $intrinsic_width = $image_variables['attributes']['width'] ?? NULL;
  $intrinsic_height = $image_variables['attributes']['height'] ?? NULL;
  if ($intrinsic_width !== NULL && $intrinsic_height !== NULL) {
    $image_variables['attributes']['data-progressive-image-width'] = $intrinsic_width;
    $image_variables['attributes']['data-progressive-image-height'] = $intrinsic_height;
    unset(
      $image_variables['attributes']['width'],
      $image_variables['attributes']['height']
    );
  }

  unset($image_variables['attributes']['use-blurry-placeholder']);
  $image_variables['attributes']['data-progressive-image'] = '';
  $image_variables['#attached']['library'][] = 'jurenites_progressive_images/loading-state';
}
