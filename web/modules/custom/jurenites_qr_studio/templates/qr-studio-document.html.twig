<!doctype html>
<html lang="{{ language_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <title>{{ 'QR Pixel Studio'|t }}
    </title>
    <meta name="description" content="{{ 'Paint, lock, encode and decode. A precise workspace for QR pixel art.'|t }}">
    <link rel="icon" type="image/svg+xml" href="{{ favicon_url }}">
    <css-placeholder token="{{ placeholder_token }}">
    <js-placeholder token="{{ placeholder_token }}">
  </head>
  <body>
    {{ editorial_copy_cache }}
    <header class="app-header">
      <a class="brand-mark" href="{{ studio_url }}" aria-label="{{ 'QR Pixel Studio home'|t }}">
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path d="M1 1h9v9H1zM14 1h9v9h-9zM1 14h9v9H1zM14 14h4v4h-4zM19 19h4v4h-4z"/>
        </svg>
        <span>{{ 'QR'|t }} <strong>{{ 'PIXEL STUDIO'|t }}</strong></span>
      </a>
      <div class="header-caption">{{ studio_copy.tagline }}</div>
      <div class="header-actions">
        <a class="quiet-button website-link" href="{{ website_url }}">{{ 'Back to website'|t }}
        </a>
        <button id="save-project" class="quiet-button">{{ 'Save project'|t }}
        </button>
        <button id="load-project" class="quiet-button">{{ 'Open project'|t }}
        </button>
        <button id="export-svg" class="primary-button">{{ 'Export SVG'|t }}
          <span aria-hidden="true">↗
          </span>
        </button>
      </div>
    </header>
    <main class="studio-layout">
      <aside class="control-panel">
        <div class="panel-heading">
          <span class="section-number">01
          </span>
          <h1>{{ 'Make your code'|t }}
          </h1>
        </div>
        <section id="text-panel" aria-label="{{ 'Encode text or find an address'|t }}">
          <label for="address-pattern">{{ 'Encoded Text'|t }}
          </label>
          <div class="pattern-field">
            <div id="pattern-highlights" aria-hidden="true">
            </div>
            <input id="address-pattern" maxlength="4096" value="HTTPS://?????.??" spellcheck="false" autocapitalize="off" autocomplete="off" aria-describedby="pattern-caption pattern-error" aria-invalid="false">
          </div>
          <p id="pattern-error" class="field-help pattern-error" aria-live="polite" hidden>
          </p>
          <p id="pattern-caption" class="field-help">{{ 'Each <code class="pattern-placeholder">?</code> is a character the search can choose. Other characters stay fixed.'|t }}</p>
          <div class="field-help">{{ studio_copy.encoding_tip }}</div>
          <button id="uppercase-host" class="text-button">{{ 'Uppercase URL host & scheme'|t }}
          </button>
          <p id="character-detail" class="field-help" aria-live="polite">{{ 'Hover a character or move the text cursor to highlight its QR data cells.'|t }}
          </p>
          <p class="field-help">{{ 'For website endings: <code>.??</code> = 2 characters, <code>.???</code> = 3, <code>.*</code> = any existing ending that fits.'|t }}</p>
          <p id="tld-status" class="field-help" aria-live="polite">
          </p>
          <details class="tld-details">
            <summary>{{ 'Browse matching domain endings'|t }}
            </summary>
            <a id="tld-source" class="text-button" target="_blank" rel="noopener noreferrer">
            </a>
            <div id="tld-list" class="tld-list">
            </div>
          </details>
          <div id="search-options">
            <label for="search-alphabet">{{ 'Name characters'|t }}
            </label>
            <select id="search-alphabet">
              <option value="alphanumeric">{{ 'A–Z and 0–9'|t }}
              </option>
              <option value="letters">{{ 'A–Z only'|t }}
              </option>
              <option value="digits">{{ '0–9 only'|t }}
              </option>
            </select>
            <label for="search-limit">{{ 'Search time'|t }}
            </label>
            <select id="search-limit">
              <option value="15">{{ '15 seconds'|t }}
              </option>
              <option value="60" selected>{{ '1 minute'|t }}
              </option>
              <option value="180">{{ '3 minutes'|t }}
              </option>
            </select>
          </div>
        </section>
        <div>
          <label for="error-level">{{ 'Correction'|t }}
          </label>
          <select id="error-level">
            <option value="L">{{ 'L · Low'|t }}
            </option>
            <option value="M">{{ 'M · Medium'|t }}
            </option>
            <option value="Q" selected>{{ 'Q · Quartile'|t }}
            </option>
            <option value="H">{{ 'H · High'|t }}
            </option>
          </select>
        </div>
        <div class="capacity-card">
          <span id="capacity-value">{{ '16 characters'|t }}
          </span>
          <span id="capacity-detail">{{ 'Alphanumeric capacity · includes HTTPS://'|t }}
          </span>
        </div>
        <button id="cancel-search" class="quiet-button wide-button" hidden>{{ 'Stop search'|t }}
        </button>
        <p id="generation-message" class="field-help" aria-live="polite">{{ 'Paint a cell to lock it. Regeneration keeps your artwork.'|t }}
        </p>
        <div class="panel-divider">
        </div>
        <div class="subheading-row">
          <h2>{{ 'Your artwork'|t }}
          </h2>
          <span class="small-caption">{{ 'PIXEL PERFECT'|t }}
          </span>
        </div>
        <button id="logo-preset" class="preset-button">
          <span class="preset-icon" aria-hidden="true">▥
          </span>
          <span>{{ 'Your logo'|t }}
            <small>{{ 'Original letters · short underline'|t }}
            </small>
          </span>
          <span aria-hidden="true">+
          </span>
        </button>
        <div class="two-columns">
          <button id="import-stencil" class="quiet-button">{{ 'Import stencil'|t }}
          </button>
          <button id="decode-image" class="quiet-button">{{ 'Decode image'|t }}
          </button>
        </div>
        <div class="field-help">{{ studio_copy.stencil_help }}</div>
        <div class="panel-divider">
        </div>
        <button id="clear-locks" class="text-button muted-button">{{ 'Release all locks'|t }}
        </button>
      </aside>
      <section class="canvas-panel" aria-label="{{ 'QR drawing workspace'|t }}">
        <div class="canvas-heading">
          <div>
            <span class="small-caption">{{ 'WORKSPACE'|t }}
            </span>
            <h2 id="canvas-title" hidden>{{ '21 × 21 modules'|t }}
            </h2>
            <div class="workspace-size">
              <label for="qr-version">{{ 'QR size'|t }}
              </label>
              <select id="qr-version">
                <option value="1">21 × 21
                </option>
                <option value="2">25 × 25
                </option>
                <option value="3">29 × 29
                </option>
                <option value="4">33 × 33
                </option>
                <option value="5">37 × 37
                </option>
                <option value="6">41 × 41
                </option>
                <option value="7">45 × 45
                </option>
                <option value="8">49 × 49
                </option>
                <option value="9">53 × 53
                </option>
                <option value="10">57 × 57
                </option>
              </select>
            </div>
          </div>
          <div class="canvas-toggles">
            <label class="check-row">
              <input id="show-expected" type="checkbox" checked>{{ 'Expected'|t }}
            </label>
            <label class="check-row">
              <input id="show-grid" type="checkbox" checked>{{ 'Grid'|t }}
            </label>
            <label class="check-row">
              <input id="show-locks" type="checkbox" checked>{{ 'Locks'|t }}
            </label>
            <label class="check-row">
              <input id="show-structure" type="checkbox">{{ 'Structure'|t }}
            </label>
            <label class="check-row">
              <input id="protect-structure" type="checkbox" checked aria-describedby="structure-help">{{ 'Protect QR structure'|t }}
            </label>
          </div>
        </div>
        <div id="structure-help" class="field-help">{{ studio_copy.structure_help }}</div>
        <div class="drawing-toolbar" role="toolbar" aria-label="{{ 'Painting tools'|t }}">
          <button data-tool="paint" aria-pressed="true" title="{{ 'Invert pixel color · B or W'|t }}">
            <span class="toggle-swatch" aria-hidden="true">
            </span>{{ 'Draw'|t }}
          </button>
          <button data-tool="lock" aria-pressed="false" title="{{ 'Toggle locked / unlocked · L or U'|t }}">{{ '▣ Lock'|t }}
          </button>
          <button data-tool="text" aria-pressed="false" aria-expanded="false" aria-controls="pixel-text-controls" title="{{ 'Show or hide pixel text controls'|t }}">{{ 'T Text'|t }}
          </button>
          <span class="toolbar-divider">
          </span>
          <button id="undo-button" title="{{ 'Undo · ⌘Z'|t }}" aria-label="{{ 'Undo'|t }}">↶
          </button>
          <button id="redo-button" title="{{ 'Redo · ⇧⌘Z'|t }}" aria-label="{{ 'Redo'|t }}">↷
          </button>
          <button id="rotate-qr" title="{{ 'Rotate the entire QR clockwise by 90°'|t }}" aria-label="{{ 'Rotate QR clockwise 90 degrees'|t }}">↻ 90°
          </button>
        </div>
        <section id="pixel-text-controls" hidden class="pixel-text-controls" aria-label="{{ 'Draggable pixel text'|t }}">
          <label for="pixel-text-input">{{ 'Pixel text · 4Pixel font'|t }}
          </label>
          <div class="pixel-text-actions">
            <input id="pixel-text-input" maxlength="32" placeholder="{{ 'YOUR TEXT'|t }}" spellcheck="false" aria-describedby="pixel-text-help">
          </div>
          <label class="check-row">
            <input type="checkbox" id="pixel-text-enabled" checked>{{ 'Text enabled · turn off to reset Draw edits'|t }}
          </label>
          <p id="pixel-text-help" class="field-help" aria-live="polite">{{ 'Uses your 4Pixel font, including its lowercase letters, spacing and descenders, with a 1 px white outline. Drag it to the grid edge to clip the border. Use Text to drag, Draw to change pixels, and Lock to release cells to the QR. Edits move with the text. Turn text off and on to reset Draw edits. Moving it restores the pixels underneath.'|t }}
          </p>
        </section>
        <div class="canvas-stage">
          <canvas id="qr-canvas" tabindex="0" role="application" aria-label="{{ 'QR pixel editor. Arrow keys move the cursor; Space applies the tool. Shift-drag paints a rectangle.'|t }}">
          </canvas>
        </div>
        <div class="expected-legend">{{ studio_copy.expected_legend }}</div>
        <div class="canvas-footer">
          <span id="cursor-position">{{ 'Hover to inspect a cell'|t }}
          </span>
          <span>{{ 'Drag to paint · Shift-drag for a rectangle'|t }}
          </span>
        </div>
        <div class="workspace-note">
          <span class="note-symbol">↳
          </span>
          <p>{{ 'The white outer border stays clear for scanning.'|t }}
            <br>
            <span>{{ 'Locked pixels belong to you. Everything else can change.'|t }}
            </span>
          </p>
        </div>
      </section>
      <aside class="inspector-panel">
        <div class="panel-heading">
          <span class="section-number">02
          </span>
          <h2>{{ 'Check the result'|t }}
          </h2>
        </div>
        <div class="subheading-row">
          <h2>{{ 'Saved matches'|t }}
          </h2>
          <span id="matches-count" class="small-caption">{{ '0 SAVED'|t }}
          </span>
        </div>
        <button id="find-next" class="primary-button wide-button">{{ 'Find next address →'|t }}
        </button>
        <div class="field-help">{{ studio_copy.saved_matches_help }}</div>
        <div id="matches-list" class="matches-list" aria-label="{{ 'Saved matching addresses'|t }}">
        </div>
        <div class="panel-divider">
        </div>
        <div id="scan-card" class="scan-card" data-state="pending">
          <div class="status-heading">
            <span id="status-icon">◇
            </span>
            <strong id="scan-status">{{ 'Checking code'|t }}
            </strong>
          </div>
          <p id="scan-description">{{ 'The finished grid is decoded here.'|t }}
          </p>
          <code id="decoded-text">
          </code>
        </div>
        <div class="mini-preview">
          <canvas id="preview-canvas" aria-label="{{ 'Clean QR preview'|t }}">
          </canvas>
          <span>{{ 'Actual export · no editor guides'|t }}
          </span>
        </div>
        <button id="verify-button" class="quiet-button wide-button">{{ 'Decode current grid'|t }}
        </button>
        <dl class="metrics-list">
          <div>
            <dt>{{ 'Locked cells'|t }}
            </dt>
            <dd id="locked-count">0
            </dd>
          </div>
          <div>
            <dt>{{ 'Black / white locks'|t }}
            </dt>
            <dd id="lock-split">0 / 0
            </dd>
          </div>
          <div>
            <dt>{{ 'Changed codewords'|t }}
            </dt>
            <dd id="damage-count">0 / 6
            </dd>
          </div>
          <div>
            <dt>{{ 'Structure changes'|t }}
            </dt>
            <dd id="structure-count">0
            </dd>
          </div>
          <div>
            <dt>{{ 'QR mask'|t }}
            </dt>
            <dd id="mask-value">{{ 'Auto'|t }}
            </dd>
          </div>
        </dl>
        <p id="risk-message" class="field-help">{{ 'Correction capacity is counted per block, not as a percentage of painted pixels.'|t }}
        </p>
        <div class="panel-divider">
        </div>
        <h2>{{ 'Candidate address'|t }}
        </h2>
        <p id="candidate-text" class="candidate-text">{{ 'Generate an address to fit your locked artwork.'|t }}
        </p>
        <button id="copy-payload" class="quiet-button wide-button">{{ 'Copy decoded text'|t }}
        </button>
        <div class="field-help">{{ studio_copy.domain_notice }}</div>
      </aside>
    </main>
    <footer class="app-footer">
      <span>{{ 'QR PIXEL STUDIO'|t }}
        <span class="footer-separator">/
        </span> {{ 'LOCAL PROCESSING'|t }}
      </span>
      <span id="workspace-status" aria-live="polite">{{ 'Ready'|t }}
      </span>
    </footer>
    <input id="project-file" type="file" accept="application/json,.json" hidden>
    <input id="stencil-file" type="file" accept="image/svg+xml,image/png,.svg,.png" hidden>
    <input id="decode-file" type="file" accept="image/*,.svg" hidden>
    <dialog id="stencil-dialog">
      <form method="dialog">
        <div class="dialog-heading">
          <h2>{{ 'Place your stencil'|t }}
          </h2>
          <button class="quiet-button" value="cancel" aria-label="{{ 'Close'|t }}">×
          </button>
        </div>
        <p id="stencil-size" class="field-help">
        </p>
        <div class="two-columns">
          <div>
            <label for="stencil-x">{{ 'Column'|t }}
            </label>
            <input id="stencil-x" type="number" min="0" value="0">
          </div>
          <div>
            <label for="stencil-y">{{ 'Row'|t }}
            </label>
            <input id="stencil-y" type="number" min="0" value="9">
          </div>
        </div>
        <label class="check-row">
          <input id="stencil-white" type="checkbox" checked>{{ 'Lock white pixels inside the artwork too'|t }}
        </label>
        <label class="check-row">
          <input id="stencil-crop" type="checkbox">{{ 'Crop artwork that extends beyond the grid'|t }}
        </label>
        <p id="stencil-message" class="field-help" role="status">
        </p>
        <button id="place-stencil" type="button" class="primary-button wide-button">{{ 'Place & lock'|t }}
        </button>
      </form>
    </dialog>
    <div id="toast-message" class="toast-message" role="status" hidden>
    </div>
    <js-bottom-placeholder token="{{ placeholder_token }}">
  </body>
</html>
