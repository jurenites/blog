{
  "name": "blog-jurenites",
  "private": true,
  "type": "module",
  "version": "1.59.3",
  "repository": {
    "type": "git",
    "url": "https://github.com/jurenites/blog.git"
  },
  "visualCredits": [
    "Alexander Ilivanov",
    "AI"
  ],
  "description": "Storybook and frontend component workspace for the Blog jurenites Drupal theme.",
  "scripts": {
    "version:check": "node scripts/project-version.mjs check",
    "version:set": "node scripts/project-version.mjs set",
    "version:bump": "node scripts/project-version.mjs bump",
    "build:info": "node scripts/build-deployment-info.mjs",
    "build:info:check": "node scripts/check-build-information.mjs",
    "lint": "npm run lint:js && npm run lint:scss && npm run lint:templates && npm run lint:tokens",
    "lint:js": "eslint .",
    "lint:scss": "stylelint \"src/**/*.scss\"",
    "lint:templates": "htmlhint \"src/**/*.template.html\"",
    "lint:tokens": "node scripts/check-token-contract.mjs",
    "build:tokens": "node scripts/build-tokens.mjs && node scripts/check-token-contract.mjs",
    "tokens:check": "node scripts/check-token-contract.mjs",
    "build:storybook-info": "node scripts/build-storybook-info.mjs",
    "figma:prepare": "npm run build:tokens && npm run figma:plugin:build",
    "figma:plugin:build": "rollup scripts/figma/plugin-main.js --format iife --file scripts/figma/dist/plugin.js",
    "build:theme": "npm run build:tokens && node scripts/build-theme.mjs",
    "build:all": "npm run build:tokens && node scripts/build-theme.mjs && npm run build-storybook && npm run build:info:check",
    "docs:check": "node scripts/check-docs-freshness.mjs",
    "test:font-preview": "node --test tests/font-preview.test.mjs",
    "test:pixel-editor": "node --test tests/pixel-glyph-editor.test.mjs",
    "test:pulse-indicator": "node --test tests/pulse-indicator.test.mjs",
    "test:portfolio-tags": "node --test tests/portfolio-tag-filtering.test.mjs",
    "test:guidelines": "node --test tests/guidelines-page.test.mjs",
    "test:timeline": "node --test tests/timeline-page.test.mjs tests/timeline-organization-rail.test.mjs",
    "test:video-grid": "node --test tests/video-grid.test.mjs",
    "playwright:install": "PLAYWRIGHT_BROWSERS_PATH=.cache/ms-playwright npx playwright install chromium",
    "storybook:inspect": "npm run build-storybook && PLAYWRIGHT_BROWSERS_PATH=.cache/ms-playwright node scripts/inspect-storybook.mjs",
    "storybook": "npm run build:tokens && npm run build:storybook-info && storybook dev -p 6006 --host 0.0.0.0 --no-open",
    "build-storybook": "npm run build:tokens && npm run build:storybook-info && storybook build"
  },
  "devDependencies": {
    "@storybook/addon-essentials": "8.6.18",
    "@storybook/html-vite": "8.6.18",
    "esbuild": "^0.25.0",
    "eslint": "^10.5.0",
    "htmlhint": "^1.9.2",
    "postcss-scss": "^4.0.9",
    "sass": "^1.100.0",
    "storybook": "8.6.18",
    "stylelint": "^17.13.0",
    "stylelint-scss": "^7.2.0",
    "vite": "^6.3.5"
  },
  "dependencies": {
    "opentype.js": "2.0.0"
  }
}
