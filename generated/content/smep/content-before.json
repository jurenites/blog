            "field_project_story_body": [
                {
                    "value": "<h2>Where the inspiration began</h2><p><a href=\"https://jhollands.co.uk/spaceplan/\" target=\"_blank\" rel=\"external\">Spaceplan</a> was the first incremental game I played, before I discovered <a href=\"https://orteil.dashnet.org/cookieclicker/\" target=\"_blank\" rel=\"external\">Cookie Clicker</a>. It was my introduction to a genre where a small action can grow into a much larger system. That became a starting point for my own project. With SMEP, I wanted to explore a different subject: particles, the formation of matter, and the possibility of learning something about physics and chemistry by playing with their ideas.</p>",
                    "format": "full_html"
                }
            ]
        },
